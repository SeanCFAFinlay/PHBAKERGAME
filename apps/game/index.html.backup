let theme, themeData, mapData;
let mapIndex = 0;
let COLS, ROWS, PATH=[], SPAWNS=[], BASE, WAVES=[];
let money, lives, wave, score, gameSpeed=1;
let autoWave=false;
let autoWaveTimer=null;
let spawnsPending=0;
let grid=[], towers=[], enemies=[], projectiles=[], particles=[];
let navVersion=0;
let selectedTower=null, selectedPlaced=null, sellMode=false, waveActive=false;
let running=false, lastTime=0, animTime=0;
let scene, camera, renderer, raycaster, mouse, cells=[];
let camAngle=Math.PI/4, camHeight=14, camDist=22;
let dragging=false, dragMoved=false, lastX=0, lastY=0, touchStart=0;

function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function selectTheme(t) {
  refreshPlayerCardForTheme(t);

  theme = t;
  themeData = THEMES[t];
  document.getElementById('mapTitle').textContent = themeData.icon + ' ' + themeData.name;
  document.getElementById('mapTitle').style.color = themeData.color;
  
  const grid = document.getElementById('mapGrid');
  grid.innerHTML = '';
  themeData.maps.forEach((m, i) => {
    const card = document.createElement('div');
    card.className = 'map-card';
    card.style.setProperty('--c', themeData.color);
    card.innerHTML = `<div class="map-card-icon">${themeData.icon}</div><div class="map-card-name">${m.name}</div><div class="map-card-info">${m.waves} Waves • ${m.cols}×${m.rows}</div><div class="map-stars">${[1,2,3,4,5].map(n=>`<span class="${n<=m.diff?'on':''}">⭐</span>`).join('')}</div>`;
    card.onclick = () => startGame(i);
    grid.appendChild(card);
  });
  showScreen('mapScreen');
}

function startGame(idx) {
  mapIndex = idx;
  mapData = themeData.maps[idx];
  COLS = mapData.cols;
  ROWS = mapData.rows;
  money = mapData.money;
  lives = mapData.lives;
  wave = 0;
  score = 0;
  gameSpeed = 1;
  grid = [];
  towers = [];
  enemies = [];
  projectiles = [];
  particles = [];
  selectedTower = null;
  selectedPlaced = null;
  sellMode = false;
  waveActive = false;
  spawnsPending = 0;
  autoWave = false;
  autoWaveTimer = null;
  const ab = document.getElementById("autoBtn");
  if (ab) { ab.textContent = "AUTO: OFF"; ab.classList.remove("on"); }
  
  generateMap();
  WAVES = generateWaves(mapData.waves);
  
  showScreen('gameScreen');
  (function waitForLayout(){
    const wrap = document.querySelector('.canvas-wrap');
    const w = wrap ? wrap.getBoundingClientRect().width : 0;
    const h = wrap ? wrap.getBoundingClientRect().height : 0;
    if (w < 20 || h < 20) { requestAnimationFrame(waitForLayout); return; }
    init3D();
    onResize(); // ensure correct renderer size on first frame
    renderTowers();
    updateHUD();
    running = true;
    lastTime = performance.now();
    gameLoop(lastTime);
  })();
}

function exitGame() {
  running = false;
  selectTheme(theme);
}



// Deterministic RNG per map/theme (so each of the 5 maps has a distinct, repeatable layout)
function mulberry32(a){return function(){var t=a+=0x6D2B79F5;t=Math.imul(t^t>>>15,t|1);t^=t+Math.imul(t^t>>>7,t|61);return((t^t>>>14)>>>0)/4294967296;};}
function makeSeededRng(){
  const themeSalt = (theme === 'bakery') ? 17 : 29;
  const seed = ((mapIndex+1) * 10007 + themeSalt) >>> 0;
  return mulberry32(seed);
}
function hash2(x,y,seed){
  // cheap stable hash -> [0,1)
  let h = (seed ^ (x*374761393) ^ (y*668265263)) >>> 0;
  h = Math.imul(h ^ (h >>> 13), 1274126177) >>> 0;
  return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
}


function generateMap() {
  // Open field: no pre-baked path tiles. Enemies navigate shortest route to BASE around obstacles/towers.
  grid = [];
  for (let y = 0; y < ROWS; y++) {
    grid[y] = [];
    for (let x = 0; x < COLS; x++) grid[y][x] = { type: 'ground', tower: null };
  }

  // Spawn points + pen (end) positions are fixed per map to support designed "puzzle" layouts
  const spawnPresets = [
    { sp:[0.22,0.52,0.82], base:0.52 },
    { sp:[0.18,0.46,0.74], base:0.36 },
    { sp:[0.26,0.50,0.74], base:0.62 },
    { sp:[0.16,0.44,0.80], base:0.50 },
    { sp:[0.20,0.50,0.80], base:0.40 }
  ];
  const p = spawnPresets[Math.max(0, Math.min(4, mapIndex))];
  SPAWNS = p.sp.map(f => ({ x: 0, y: Math.max(0, Math.min(ROWS-1, Math.round(f*(ROWS-1)))) }));
  BASE = { x: COLS - 1, y: Math.max(0, Math.min(ROWS-1, Math.round(p.base*(ROWS-1)))) };

  // Mark tiles
  for (const s of SPAWNS) grid[s.y][s.x].type = 'spawn';
  grid[BASE.y][BASE.x].type = 'base';

  // Place solid "items" (obstacles) that create choke points.
  generateObstacles();

  navVersion++;
}

function generateObstacles() {
  // Designed, theme-forward "puzzle" layouts:
  // - Big, readable baking/dental items (larger than towers)
  // - Intentional funnels + pockets that reward smart placement
  // - Deterministic per theme + map (Map 1..5 always feels the same)

  // Clear previous obstacles
  for (let y = 0; y < ROWS; y++) {
    for (let x = 0; x < COLS; x++) if (grid[y][x].type === 'obstacle') grid[y][x].type = 'ground';
  }

  const blocked = new Set([`${BASE.x},${BASE.y}`]);
  for (const s of SPAWNS) blocked.add(`${s.x},${s.y}`);

  const canPlace = (x,y) => {
    const key = `${x},${y}`;
    if (x < 0 || x >= COLS || y < 0 || y >= ROWS) return false;
    if (blocked.has(key)) return false;
    if (grid[y][x].type !== 'ground') return false;
    // buffer around spawns/base so the "ports" and pen remain readable
    for (const s of SPAWNS) { if (Math.abs(x - s.x) + Math.abs(y - s.y) <= 1) return false; }
    if (Math.abs(x - BASE.x)  + Math.abs(y - BASE.y)  <= 1) return false;
    return true;
  };
  const place = (x,y) => {
    if (!canPlace(x,y)) return false;
    grid[y][x].type = 'obstacle';
    return true;
  };

  const placeRect = (x,y,w,h) => {
    for (let yy=y; yy<y+h; yy++) for (let xx=x; xx<x+w; xx++) place(xx,yy);
  };
  const placeLine = (x,y,dx,dy,len,th=1) => {
    for (let i=0;i<len;i++){
      for (let t=0;t<th;t++){
        const xx = x + dx*i + (dy!==0 ? t : 0);
        const yy = y + dy*i + (dx!==0 ? t : 0);
        place(xx,yy);
      }
    }
  };

  const rx = f => Math.max(0, Math.min(COLS-1, Math.round(f*(COLS-1))));
  const ry = f => Math.max(0, Math.min(ROWS-1, Math.round(f*(ROWS-1))));

  // Carve a guaranteed lane (in case the board size is small on early maps)
  const carveLane = () => {
    // clear a 2-tile-tall lane through the middle
    const mid = Math.floor(ROWS/2);
    for (let x=0;x<COLS;x++){
      for (let y=Math.max(0,mid-1); y<=Math.min(ROWS-1,mid); y++){
        if (grid[y][x].type === 'obstacle') grid[y][x].type = 'ground';
      }
    }
  };

  const buildLayout = (layoutFn) => {
    layoutFn();
    // Ensure at least one initial walkable path exists from each spawn.
    // If not, carve a lane and retry once with a lighter touch.
    let ok = true;
    for (const s of SPAWNS) {
      const p = findPathGrid(s.x, s.y, BASE.x, BASE.y, false);
      if (!(p && p.length > 0)) { ok = false; break; }
    }
    if (!ok) {
      carveLane();
    }
  };

  const L = [];

  // Map 1: two “boxes” create a clean double-funnel (great for learning)
  L.push(() => {
    placeRect(rx(0.35), ry(0.18), 3, ry(0.30)-ry(0.18)+1);           // upper big box
    placeRect(rx(0.35), ry(0.58), 3, ry(0.80)-ry(0.58)+1);           // lower big box
    placeRect(rx(0.55), ry(0.36), 4, 3);                             // center tool tray
    placeLine(rx(0.52), ry(0.10), 0, 1, ry(0.40)-ry(0.10), 2);        // rim clutter (left)
    placeLine(rx(0.52), ry(0.60), 0, 1, ry(0.90)-ry(0.60), 2);        // rim clutter (left)
  });

  // Map 2: “zig-zag prep station” creates alternating choke pockets
  L.push(() => {
    // three big stations staggered
    placeRect(rx(0.25), ry(0.20), 4, 3);
    placeRect(rx(0.42), ry(0.45), 4, 3);
    placeRect(rx(0.60), ry(0.22), 4, 3);
    placeRect(rx(0.72), ry(0.55), 4, 3);
    // soft walls that encourage an S-curve
    placeLine(rx(0.34), ry(0.08), 0, 1, ry(0.92)-ry(0.08), 1);
    placeLine(rx(0.54), ry(0.10), 0, 1, ry(0.90)-ry(0.10), 1);
  });

  // Map 3: “rack lanes” — long channels with two intentional gates
  L.push(() => {
    const x1 = rx(0.30), x2 = rx(0.55), x3 = rx(0.78);
    placeLine(x1, 1, 0, 1, ROWS-2, 2);
    placeLine(x2, 1, 0, 1, ROWS-2, 2);
    // cut two gates in each rack wall
    const g1 = ry(0.35), g2 = ry(0.70);
    for (let yy=g1-1; yy<=g1+1; yy++){ for (let t=0;t<2;t++){ if(grid[yy] && grid[yy][x1+t]) grid[yy][x1+t].type='ground'; if(grid[yy] && grid[yy][x2+t]) grid[yy][x2+t].type='ground'; } }
    for (let yy=g2-1; yy<=g2+1; yy++){ for (let t=0;t<2;t++){ if(grid[yy] && grid[yy][x1+t]) grid[yy][x1+t].type='ground'; if(grid[yy] && grid[yy][x2+t]) grid[yy][x2+t].type='ground'; } }
    // big item islands to force choice of lane
    placeRect(rx(0.12), ry(0.50), 3, 3);
    placeRect(rx(0.90)-2, ry(0.50), 3, 3);
    placeRect(rx(0.66), ry(0.40), 3, 4);
  });

  // Map 4: “four islands” — classic tower-defense puzzle: corners + mid gate
  L.push(() => {
    placeRect(rx(0.22), ry(0.18), 4, 4);
    placeRect(rx(0.22), ry(0.70)-3, 4, 4);
    placeRect(rx(0.74)-3, ry(0.18), 4, 4);
    placeRect(rx(0.74)-3, ry(0.70)-3, 4, 4);
    // a mid “toolbox wall” with two openings -> strong funnel spots
    placeLine(rx(0.50), ry(0.12), 0, 1, ry(0.88)-ry(0.12), 2);
    const o1 = ry(0.33), o2 = ry(0.66);
    for (let yy=o1-1; yy<=o1+1; yy++){ for (let t=0;t<2;t++){ if(grid[yy] && grid[yy][rx(0.50)+t]) grid[yy][rx(0.50)+t].type='ground'; } }
    for (let yy=o2-1; yy<=o2+1; yy++){ for (let t=0;t<2;t++){ if(grid[yy] && grid[yy][rx(0.50)+t]) grid[yy][rx(0.50)+t].type='ground'; } }
  });

  // Map 5: “final prep maze” — dense but readable, with 3 gates and a late pinch
  L.push(() => {
    // perimeter stations
    placeLine(rx(0.15), ry(0.10), 0, 1, ry(0.90)-ry(0.10), 2);
    placeLine(rx(0.85), ry(0.10), 0, 1, ry(0.90)-ry(0.10), 2);
    // inner walls creating 3 gates
    placeLine(rx(0.40), ry(0.12), 0, 1, ry(0.88)-ry(0.12), 2);
    placeLine(rx(0.62), ry(0.12), 0, 1, ry(0.88)-ry(0.12), 2);

    const gates = [ry(0.24), ry(0.52), ry(0.78)];
    for (const gy of gates){
      for (let yy=gy-1; yy<=gy+1; yy++){
        for (let t=0;t<2;t++){
          const xA = rx(0.40)+t, xB = rx(0.62)+t;
          if (grid[yy] && grid[yy][xA]) grid[yy][xA].type='ground';
          if (grid[yy] && grid[yy][xB]) grid[yy][xB].type='ground';
        }
      }
    }

    // late pinch near the pen
    placeRect(rx(0.72), ry(0.40), 4, 3);
    placeRect(rx(0.72), ry(0.58), 4, 3);
  });

  buildLayout(L[Math.max(0, Math.min(4, mapIndex))]);
}


// A* pathfinding on the current grid.
// - Obstacles are never passable.
// - Towers are either blocked (allowBreak=false) or passable with high cost (allowBreak=true) so enemies can "break through" if fully walled.
function findPathGrid(sx, sy, gx, gy, allowBreak) {
  const inBounds = (x, y) => x >= 0 && x < COLS && y >= 0 && y < ROWS;
  const key = (x, y) => x + "," + y;

  const h = (x, y) => Math.abs(gx - x) + Math.abs(gy - y);

  const open = [];
  const came = new Map();
  const gScore = new Map();
  const fScore = new Map();

  const startK = key(sx, sy);
  gScore.set(startK, 0);
  fScore.set(startK, h(sx, sy));
  open.push([sx, sy]);

  const getCost = (x, y) => {
    const c = grid[y][x];
    if (c.type === 'obstacle') return Infinity;
    if (c.tower) return allowBreak ? 30 : Infinity;
    return 1;
  };

  while (open.length) {
    // pick lowest fScore
    let bestIdx = 0;
    let bestF = Infinity;
    for (let i = 0; i < open.length; i++) {
      const [ox, oy] = open[i];
      const k = key(ox, oy);
      const f = fScore.get(k) ?? Infinity;
      if (f < bestF) { bestF = f; bestIdx = i; }
    }
    const [cx, cy] = open.splice(bestIdx, 1)[0];
    if (cx === gx && cy === gy) {
      // reconstruct
      const path = [];
      let curK = key(cx, cy);
      let cur = [cx, cy];
      path.push(cur);
      while (came.has(curK)) {
        cur = came.get(curK);
        curK = key(cur[0], cur[1]);
        path.push(cur);
      }
      path.reverse();
      return path;
    }

    const cK = key(cx, cy);
    const cG = gScore.get(cK) ?? Infinity;

    const neigh = [[cx+1, cy], [cx-1, cy], [cx, cy+1], [cx, cy-1]];
    for (const [nx, ny] of neigh) {
      if (!inBounds(nx, ny)) continue;
      const step = getCost(nx, ny);
      if (step === Infinity) continue;

      const nK = key(nx, ny);
      const tentative = cG + step;
      const prev = gScore.get(nK);
      if (prev === undefined || tentative < prev) {
        came.set(nK, [cx, cy]);
        gScore.set(nK, tentative);
        fScore.set(nK, tentative + h(nx, ny));
        // push if not already
        if (!open.some(p => p[0] === nx && p[1] === ny)) open.push([nx, ny]);
      }
    }
  }
  return null;
}

function onNavChanged() {
  navVersion++;
  // Re-path all existing enemies from their current cell
  const hw = COLS/2, hh = ROWS/2;
  for (const e of enemies) {
    if (e.flying) continue;
    const gx = Math.max(0, Math.min(COLS-1, Math.floor(e.x + hw)));
    const gy = Math.max(0, Math.min(ROWS-1, Math.floor(e.z + hh)));
    e.path = findPathGrid(gx, gy, BASE.x, BASE.y, true);
    e.pathIdx = 1;
    e.navV = navVersion;
  }
}

function addObstacleVisuals(hw, hh) {
  // Render obstacle props at obstacle cells.
  // Important: props are BIGGER than towers (Tower Madness Zero feel), and are deterministic per-map.
  const isBakery = theme === 'bakery';
  const themeSalt = isBakery ? 17 : 29;
  const seed = ((mapIndex+1) * 10007 + themeSalt) >>> 0;

  const baseY = 0.12;

  const mat = {
    metal: new THREE.MeshStandardMaterial({ color: 0xcfd3df, roughness: 0.25, metalness: 0.85 }),
    wood:  new THREE.MeshStandardMaterial({ color: 0xcaa472, roughness: 0.75, metalness: 0.05 }),
    card:  new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.85, metalness: 0.02 }),
    plastic:new THREE.MeshStandardMaterial({ color: 0xffe7fb, roughness: 0.55, metalness: 0.05 }),
    rubber: new THREE.MeshStandardMaterial({ color: 0x111827, roughness: 0.65, metalness: 0.05 }),
    blue:  new THREE.MeshStandardMaterial({ color: 0x7fe9ff, roughness: 0.35, metalness: 0.20 }),
    mint:  new THREE.MeshStandardMaterial({ color: 0x98f5d0, roughness: 0.45, metalness: 0.15 }),
    gold:  new THREE.MeshStandardMaterial({ color: 0xfbbf24, roughness: 0.35, metalness: 0.35 })
  };

  const jitter = (x,y,mag=0.07) => (hash2(x,y,seed) - 0.5) * 2 * mag;

  function bakingProp(kind){
    const g = new THREE.Group();

    if (kind === 0) {
      // Rolling pin (big)
      const body = new THREE.Mesh(new THREE.CylinderGeometry(0.16,0.16,1.05,16), mat.wood);
      body.rotation.z = Math.PI/2;
      body.position.y = 0.32;
      g.add(body);
      const h1 = new THREE.Mesh(new THREE.CylinderGeometry(0.06,0.06,0.28,12), mat.wood);
      h1.rotation.z = Math.PI/2; h1.position.set(-0.68,0.32,0);
      const h2 = h1.clone(); h2.position.x = 0.68;
      g.add(h1); g.add(h2);
    } else if (kind === 1) {
      // Whisk
      const handle = new THREE.Mesh(new THREE.CylinderGeometry(0.07,0.08,0.75,14), mat.metal);
      handle.rotation.z = Math.PI/2;
      handle.position.set(0,0.28,0);
      g.add(handle);
      const head = new THREE.Group();
      for (let i=0;i<6;i++){
        const w = new THREE.Mesh(new THREE.TorusGeometry(0.16 + i*0.03, 0.015, 8, 22), mat.metal);
        w.rotation.x = Math.PI/2;
        w.position.set(0.38,0.28,0);
        head.add(w);
      }
      g.add(head);
    } else if (kind === 2) {
      // Baking box / carton
      const box = new THREE.Mesh(new THREE.BoxGeometry(0.95,0.55,0.65), mat.card);
      box.position.y = 0.36;
      g.add(box);
      const label = new THREE.Mesh(new THREE.PlaneGeometry(0.55,0.30), mat.plastic);
      label.position.set(0,0.40,0.33);
      g.add(label);
    } else if (kind === 3) {
      // Cookie tray / sheet pan
      const pan = new THREE.Mesh(new THREE.BoxGeometry(1.05,0.10,0.75), mat.metal);
      pan.position.y = 0.20;
      g.add(pan);
      const rim = new THREE.Mesh(new THREE.BoxGeometry(1.08,0.14,0.78), new THREE.MeshStandardMaterial({ color: 0xbfc6d2, roughness:0.35, metalness:0.65, transparent:true, opacity:0.55 }));
      rim.position.y = 0.24;
      g.add(rim);
    } else {
      // Mixing bowl + spatula
      const bowl = new THREE.Mesh(new THREE.SphereGeometry(0.42, 18, 12, 0, Math.PI*2, 0, Math.PI/2), mat.card);
      bowl.position.y = 0.34;
      g.add(bowl);
      const spat = new THREE.Mesh(new THREE.BoxGeometry(0.12,0.04,0.85), mat.rubber);
      spat.rotation.y = Math.PI/4;
      spat.position.set(0.05,0.28,0.05);
      g.add(spat);
      const handle = new THREE.Mesh(new THREE.CylinderGeometry(0.03,0.03,0.55,10), mat.wood);
      handle.rotation.z = Math.PI/2;
      handle.position.set(-0.20,0.30,0.00);
      g.add(handle);
    }

    g.scale.setScalar(1.15);
    return g;
  }

  function dentalProp(kind){
    const g = new THREE.Group();

    if (kind === 0) {
      // Tooth (big)
      const tooth = new THREE.Mesh(new THREE.SphereGeometry(0.40, 18, 14), mat.card);
      tooth.scale.set(0.85, 1.15, 0.85);
      tooth.position.y = 0.45;
      g.add(tooth);
      const root1 = new THREE.Mesh(new THREE.CylinderGeometry(0.10,0.14,0.38,10), mat.card);
      root1.position.set(-0.12,0.18,0);
      const root2 = root1.clone(); root2.position.x = 0.12;
      g.add(root1); g.add(root2);
    } else if (kind === 1) {
      // Toothbrush
      const handle = new THREE.Mesh(new THREE.BoxGeometry(1.05,0.14,0.18), mat.mint);
      handle.position.y = 0.25;
      g.add(handle);
      const head = new THREE.Mesh(new THREE.BoxGeometry(0.30,0.18,0.22), mat.blue);
      head.position.set(0.55,0.27,0);
      g.add(head);
      for (let i=0;i<6;i++){
        const br = new THREE.Mesh(new THREE.CylinderGeometry(0.02,0.02,0.12,8), mat.card);
        br.position.set(0.46 + (i%3)*0.08, 0.36, (i<3?-0.05:0.05));
        g.add(br);
      }
    } else if (kind === 2) {
      // Floss box
      const box = new THREE.Mesh(new THREE.BoxGeometry(0.85,0.40,0.55), mat.card);
      box.position.y = 0.30;
      g.add(box);
      const lid = new THREE.Mesh(new THREE.BoxGeometry(0.85,0.08,0.55), mat.blue);
      lid.position.y = 0.52;
      g.add(lid);
    } else if (kind === 3) {
      // Mouth mirror (handle + round mirror)
      const h = new THREE.Mesh(new THREE.CylinderGeometry(0.05,0.05,0.95,12), mat.metal);
      h.rotation.z = Math.PI/2;
      h.position.y = 0.25;
      g.add(h);
      const ring = new THREE.Mesh(new THREE.TorusGeometry(0.22,0.03,10,26), mat.metal);
      ring.rotation.y = Math.PI/2;
      ring.position.set(0.55,0.28,0);
      g.add(ring);
      const glass = new THREE.Mesh(new THREE.CircleGeometry(0.20, 22), new THREE.MeshStandardMaterial({ color: 0xffffff, roughness:0.05, metalness:0.0, transparent:true, opacity:0.35 }));
      glass.rotation.y = Math.PI/2;
      glass.position.set(0.55,0.28,0.001);
      g.add(glass);
    } else {
      // Tool tray cart (box + legs)
      const tray = new THREE.Mesh(new THREE.BoxGeometry(0.95,0.10,0.65), mat.metal);
      tray.position.y = 0.35;
      g.add(tray);
      for (const sx of [-0.38,0.38]) for (const sz of [-0.25,0.25]){
        const leg = new THREE.Mesh(new THREE.CylinderGeometry(0.03,0.03,0.45,10), mat.metal);
        leg.position.set(sx,0.18,sz);
        g.add(leg);
      }
    }

    g.scale.setScalar(1.15);
    return g;
  }

  for (let y = 0; y < ROWS; y++) {
    for (let x = 0; x < COLS; x++) {
      if (grid[y][x].type !== 'obstacle') continue;

      // deterministic kind per cell + map
      const r = hash2(x,y,seed);
      const kind = Math.floor(r * 5);

      const wx = x - hw + 0.5;
      const wz = y - hh + 0.5;

      const prop = isBakery ? bakingProp(kind) : dentalProp(kind);
      // Obstacles should read bigger than towers
      prop.scale.setScalar(1.35);
      prop.position.set(wx + jitter(x,y,0.06), baseY, wz + jitter(y,x,0.06));
      prop.rotation.y = (hash2(y,x,seed+1234) - 0.5) * 0.6;
      prop.traverse(o => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });
      scene.add(prop);
    }
  }
}



function addPerimeterDecor(hw, hh) {
  // Decorative items around the tray edges (non-interactive)
  const isBakery = theme === 'bakery';
  const ring = [];
  const pad = 1.6; // outside the playable grid
  for (let x = -hw - pad; x <= hw + pad; x += 1.2) {
    ring.push([x, -hh - pad]);
    ring.push([x, hh + pad]);
  }
  for (let z = -hh - pad; z <= hh + pad; z += 1.2) {
    ring.push([-hw - pad, z]);
    ring.push([hw + pad, z]);
  }

  const place = (wx, wz) => {
    if (isBakery) {
      const kind = Math.floor(Math.random() * 4);
      if (kind === 0) {
        // cupcake stack
        const base = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.28, 0.16, 16),
          new THREE.MeshStandardMaterial({ color: 0xf7d6e0, roughness: 0.6 }));
        base.position.set(wx, 0.12, wz); base.castShadow = true; scene.add(base);
        const top = new THREE.Mesh(new THREE.SphereGeometry(0.18, 16, 12),
          new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.8 }));
        top.position.set(wx, 0.25, wz); top.castShadow = true; scene.add(top);
      } else if (kind === 1) {
        // rolling pin
        const pin = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 0.7, 12),
          new THREE.MeshStandardMaterial({ color: 0xcaa472, roughness: 0.85 }));
        pin.rotation.z = Math.random() * Math.PI;
        pin.position.set(wx, 0.1, wz); pin.castShadow = true; scene.add(pin);
      } else if (kind === 2) {
        // candy jar
        const jar = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.22, 0.35, 14),
          new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.35 }));
        jar.position.set(wx, 0.18, wz); jar.castShadow = true; scene.add(jar);
      } else {
        // whisk bundle
        const whisk = new THREE.Mesh(new THREE.ConeGeometry(0.12, 0.38, 10),
          new THREE.MeshStandardMaterial({ color: 0xaaaaaa, roughness: 0.25, metalness: 0.8 }));
        whisk.position.set(wx, 0.2, wz); whisk.castShadow = true; scene.add(whisk);
      }
    } else {
      // Dentist edge clutter
      const kind = Math.floor(Math.random() * 3);
      if (kind === 0) {
        const box = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.25, 0.35),
          new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.5 }));
        box.position.set(wx, 0.14, wz); box.castShadow = true; scene.add(box);
      } else if (kind === 1) {
        const bottle = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, 0.34, 12),
          new THREE.MeshStandardMaterial({ color: 0x7fe9ff, roughness: 0.35 }));
        bottle.position.set(wx, 0.18, wz); bottle.castShadow = true; scene.add(bottle);
      } else {
        const tool = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.6, 10),
          new THREE.MeshStandardMaterial({ color: 0xcfd3df, roughness: 0.2, metalness: 0.9 }));
        tool.rotation.z = Math.random() * Math.PI;
        tool.position.set(wx, 0.1, wz); tool.castShadow = true; scene.add(tool);
      }
    }
  };

  // Place a subset
  for (let i = 0; i < ring.length; i++) {
    if (Math.random() < 0.24) place(ring[i][0] + (Math.random()-0.5)*0.25, ring[i][1] + (Math.random()-0.5)*0.25);
  }
}

function generateWaves(num) {
  const waves = [];
  const e = themeData.enemies;
  for (let w = 1; w <= num; w++) {
    const wv = {};
    wv[e[0].id] = 5 + Math.floor(w * 1.3);
    if (w >= 2) wv[e[1].id] = Math.floor(w * 0.6);
    if (w >= 3) wv[e[2].id] = Math.floor(w * 0.7);
    if (w >= 5) wv[e[3].id] = Math.floor((w-3) * 0.4);
    if (w >= 8) wv[e[4].id] = Math.floor((w-6) * 0.25);
    if (w >= 10) wv[e[5].id] = Math.floor((w-8) * 0.35);
    if (w % 5 === 0) wv[e[6].id] = 1 + Math.floor(w / 12);
    waves.push(wv);
  }
  return waves;
}

function init3D() {
  const wrap = document.querySelector('.canvas-wrap');
  const canvas = document.getElementById('gameCanvas');
  if (renderer) renderer.dispose();
  
  const w = wrap.clientWidth, h = wrap.clientHeight;
  scene = new THREE.Scene();
  scene.background = new THREE.Color(themeData.envColor);
  scene.fog = new THREE.Fog(themeData.envColor, 35, 70);
  
  camera = new THREE.PerspectiveCamera(50, w/h, 0.1, 200);
  camDist = Math.max(COLS, ROWS) * 0.9;
  camHeight = camDist * 0.6;
  updateCamera();
  
  renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: 'high-performance' });
  renderer.setSize(w, h);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  
  scene.add(new THREE.AmbientLight(0xaabbcc, 0.6));
  const sun = new THREE.DirectionalLight(0xffffff, 1.2);
  sun.position.set(COLS*0.4, 25, ROWS*0.4);
  sun.castShadow = true;
  sun.shadow.mapSize.width = 2048;
  sun.shadow.mapSize.height = 2048;
  sun.shadow.camera.near = 1;
  sun.shadow.camera.far = 60;
  sun.shadow.camera.left = -COLS;
  sun.shadow.camera.right = COLS;
  sun.shadow.camera.top = ROWS;
  sun.shadow.camera.bottom = -ROWS;
  scene.add(sun);
  
  // Add rim light for better depth
  const rimLight = new THREE.DirectionalLight(0x4488ff, 0.3);
  rimLight.position.set(-COLS*0.5, 15, -ROWS*0.5);
  scene.add(rimLight);
  
  raycaster = new THREE.Raycaster();
  mouse = new THREE.Vector2();
  
  if (theme === 'bakery') buildBakeryKitchen();
  else buildDentistClinic();
  
  canvas.addEventListener('touchstart', onTouchStart, { passive: false });
  canvas.addEventListener('touchmove', onTouchMove, { passive: false });
  canvas.addEventListener('touchend', onTouchEnd, { passive: false });
  canvas.addEventListener('mousedown', onMouseDown);
  canvas.addEventListener('mousemove', onMouseMove);
  canvas.addEventListener('mouseup', onMouseUp);
  canvas.addEventListener('wheel', onWheel, { passive: false });
  canvas.addEventListener('click', onClick);
  window.addEventListener('resize', onResize);
}

function buildBakeryKitchen() {
  cells = [];
  const hw = COLS/2, hh = ROWS/2;


  // Baking tray / sheet mockup floor (Tower Madness Zero vibe)
  const trayTex = new THREE.TextureLoader().load(TRAY_IMG);
  trayTex.wrapS = trayTex.wrapT = THREE.ClampToEdgeWrapping;
  trayTex.anisotropy = 8;

  const trayPlane = new THREE.Mesh(
    new THREE.PlaneGeometry(COLS + 3.2, ROWS + 3.2),
    new THREE.MeshStandardMaterial({ map: trayTex, roughness: 0.95, metalness: 0.0 })
  );
  trayPlane.rotation.x = -Math.PI/2;
  trayPlane.position.set(0, 0.0, 0);
  trayPlane.receiveShadow = true;
  scene.add(trayPlane);

  // Subtle build-grid overlay (keeps placement readable without a tiled floor)
  const gridMat = new THREE.MeshBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.08 });
  for (let x = 0; x <= COLS; x++) {
    const line = new THREE.Mesh(new THREE.PlaneGeometry(0.03, ROWS), gridMat);
    line.rotation.x = -Math.PI/2;
    line.position.set(x - hw, 0.01, 0);
    scene.add(line);
  }
  for (let z = 0; z <= ROWS; z++) {
    const line = new THREE.Mesh(new THREE.PlaneGeometry(COLS, 0.03), gridMat);
    line.rotation.x = -Math.PI/2;
    line.position.set(0, 0.01, z - hh);
    scene.add(line);
  }

  // Counter lip (soft rim)
  const rimMat = new THREE.MeshLambertMaterial({ color: 0xffffff });
  [[0, -hh-0.7, COLS+1.8, 0.5, 0.35], [0, hh+0.7, COLS+1.8, 0.5, 0.35], [-hw-0.7, 0, 0.35, 0.5, ROWS+1.8], [hw+0.7, 0, 0.35, 0.5, ROWS+1.8]].forEach(([x,z,w,h,d]) => {
    const rim = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), rimMat);
    rim.position.set(x, h/2, z);
    rim.castShadow = true;
    scene.add(rim);
  });

  // Decorative obstacles (visual only)
  addCookieCutter(-hw*0.25, -hh*0.25);
  addCookieCutter(hw*0.22, hh*0.2);
  addFlourPile(-hw*0.05, hh*0.05);
  addWoodenSpoonProp(hw*0.1, -hh*0.2);
  addHandMixerProp(-hw*0.18, hh*0.22);
  addPerimeterDecor(hw, hh);

  addObstacleVisuals(hw, hh);
  addSpawnAndPenVisuals(hw, hh);
  buildCells(hw, hh);
  buildLights(hw, hh);
}

function buildDentistClinic() {
  cells = [];
  const hw = COLS/2, hh = ROWS/2;

  // Sterile "tray" floor so Bakery + Dentist share the same Tower Madness Zero board read
  const trayTex = new THREE.TextureLoader().load(TRAY_IMG);
  trayTex.wrapS = trayTex.wrapT = THREE.ClampToEdgeWrapping;
  trayTex.anisotropy = 8;

  const trayPlane = new THREE.Mesh(
    new THREE.PlaneGeometry(COLS + 3.2, ROWS + 3.2),
    new THREE.MeshStandardMaterial({ map: trayTex, roughness: 0.85, metalness: 0.05 })
  );
  trayPlane.rotation.x = -Math.PI/2;
  trayPlane.position.set(0, 0.0, 0);
  trayPlane.receiveShadow = true;
  scene.add(trayPlane);

  // Subtle build-grid overlay
  const gridMat = new THREE.MeshBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.08 });
  for (let x = 0; x <= COLS; x++) {
    const line = new THREE.Mesh(new THREE.PlaneGeometry(0.03, ROWS), gridMat);
    line.rotation.x = -Math.PI/2;
    line.position.set(x - hw, 0.01, 0);
    scene.add(line);
  }
  for (let z = 0; z <= ROWS; z++) {
    const line = new THREE.Mesh(new THREE.PlaneGeometry(COLS, 0.03), gridMat);
    line.rotation.x = -Math.PI/2;
    line.position.set(0, 0.01, z - hh);
    scene.add(line);
  }

  // Rim
  const rimMat = new THREE.MeshLambertMaterial({ color: 0xffffff });
  [[0, -hh-0.7, COLS+1.8, 0.5, 0.35], [0, hh+0.7, COLS+1.8, 0.5, 0.35], [-hw-0.7, 0, 0.35, 0.5, ROWS+1.8], [hw+0.7, 0, 0.35, 0.5, ROWS+1.8]].forEach(([x,z,w,h,d]) => {
    const rim = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), rimMat);
    rim.position.set(x, h/2, z);
    rim.castShadow = true;
    scene.add(rim);
  });

  // Walls / cabinets
  const wallMat = new THREE.MeshLambertMaterial({ color: 0xffffff });
  [[0, -hh-0.8, COLS+2.0, 0.8, 0.3], [0, hh+0.8, COLS+2.0, 0.8, 0.3]].forEach(([x,z,w,h,d]) => {
    const wall = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), wallMat);
    wall.position.set(x, h/2, z);
    wall.castShadow = true;
    scene.add(wall);
  });

  // Dental chair + lamp (visual only)
  addDentalChair(0, 0);
  addMouthwashBottle(-hw*0.22, -hh*0.18);
  addFlossSpool(hw*0.22, -hh*0.1);
  addMirrorProp(-hw*0.12, hh*0.22);
  addPerimeterDecor(hw, hh);

  addObstacleVisuals(hw, hh);
  addSpawnAndPenVisuals(hw, hh);
  buildCells(hw, hh);
  buildLights(hw, hh);
}

// --- Bakery props ---
function addCookieCutter(x, z) {
  const mat = new THREE.MeshStandardMaterial({ color: 0xd9d9e6, metalness: 0.9, roughness: 0.15 });
  const ring = new THREE.Mesh(new THREE.TorusGeometry(0.45, 0.05, 10, 5), mat);
  ring.position.set(x, 0.08, z);
  ring.rotation.x = Math.PI/2;
  ring.castShadow = true;
  scene.add(ring);
}
function addFlourPile(x, z) {
  const mat = new THREE.MeshLambertMaterial({ color: 0xffffff });
  for (let i = 0; i < 3; i++) {
    const mound = new THREE.Mesh(new THREE.SphereGeometry(0.35 - i*0.08, 10, 10), mat);
    mound.position.set(x + (Math.random()-0.5)*0.15, 0.18 - i*0.03, z + (Math.random()-0.5)*0.15);
    mound.castShadow = true;
    scene.add(mound);
  }
  // Dust motes
  for (let i = 0; i < 10; i++) {
    const mote = new THREE.Mesh(new THREE.SphereGeometry(0.02, 6, 6), new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.35 }));
    mote.position.set(x + (Math.random()-0.5)*0.9, 0.45 + Math.random()*0.6, z + (Math.random()-0.5)*0.9);
    scene.add(mote);
  }
}
function addWoodenSpoonProp(x, z) {
  const wood = new THREE.MeshStandardMaterial({ color: 0xb07a3a, metalness: 0.05, roughness: 0.85 });
  const handle = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 1.2, 10), wood);
  handle.position.set(x, 0.12, z);
  handle.rotation.z = Math.PI/2;
  handle.castShadow = true;
  scene.add(handle);
  const bowl = new THREE.Mesh(new THREE.SphereGeometry(0.18, 12, 10), wood);
  bowl.scale.set(1.4, 0.7, 1.0);
  bowl.position.set(x + 0.62, 0.14, z);
  bowl.castShadow = true;
  scene.add(bowl);
}
function addHandMixerProp(x, z) {
  const body = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.25, 0.25), new THREE.MeshStandardMaterial({ color: 0xffffff, metalness: 0.15, roughness: 0.65 }));
  body.position.set(x, 0.22, z);
  body.castShadow = true;
  scene.add(body);
  const chrome = new THREE.MeshStandardMaterial({ color: 0xcfd3df, metalness: 0.95, roughness: 0.15 });
  [-0.12, 0.12].forEach(dx => {
    const beater = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 0.35, 10), chrome);
    beater.position.set(x + dx, 0.05, z + 0.12);
    beater.castShadow = true;
    scene.add(beater);
    const whisk = new THREE.Mesh(new THREE.TorusGeometry(0.06, 0.01, 8, 18), chrome);
    whisk.position.set(x + dx, 0.0, z + 0.12);
    whisk.rotation.x = Math.PI/2;
    scene.add(whisk);
  });
}

// --- Dentist props ---
function addDentalChair(x, z) {
  const base = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.18, 0.8), new THREE.MeshLambertMaterial({ color: 0xdbeafe }));
  base.position.set(x, 0.1, z);
  base.castShadow = true;
  scene.add(base);
  const seat = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.2, 0.6), new THREE.MeshLambertMaterial({ color: 0x93c5fd }));
  seat.position.set(x, 0.28, z);
  seat.castShadow = true;
  scene.add(seat);
  const back = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.45, 0.18), new THREE.MeshLambertMaterial({ color: 0x60a5fa }));
  back.position.set(x-0.05, 0.55, z-0.22);
  back.rotation.x = -0.25;
  back.castShadow = true;
  scene.add(back);

  const arm = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 1.2, 10), new THREE.MeshLambertMaterial({ color: 0xffffff }));
  arm.position.set(x+0.55, 0.75, z-0.15);
  arm.castShadow = true;
  scene.add(arm);
  const lamp = new THREE.Mesh(new THREE.SphereGeometry(0.25, 14, 14), new THREE.MeshBasicMaterial({ color: 0xffffee }));
  lamp.position.set(x+0.55, 1.25, z-0.15);
  scene.add(lamp);
}
function addMouthwashBottle(x, z) {
  const bottle = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.22, 0.55, 14), new THREE.MeshStandardMaterial({ color: 0x22c7c5, metalness: 0.1, roughness: 0.35, transparent: true, opacity: 0.85 }));
  bottle.position.set(x, 0.3, z);
  bottle.castShadow = true;
  scene.add(bottle);
  const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.14, 0.14, 12), new THREE.MeshStandardMaterial({ color: 0xffffff, metalness: 0.2, roughness: 0.5 }));
  cap.position.set(x, 0.63, z);
  scene.add(cap);
}
function addFlossSpool(x, z) {
  const mat = new THREE.MeshStandardMaterial({ color: 0xffffff, metalness: 0.2, roughness: 0.6 });
  const spool = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 0.25, 16), mat);
  spool.position.set(x, 0.16, z);
  spool.rotation.x = Math.PI/2;
  spool.castShadow = true;
  scene.add(spool);
  const floss = new THREE.Mesh(new THREE.TorusGeometry(0.22, 0.03, 8, 24), new THREE.MeshBasicMaterial({ color: 0x7fe9ff, transparent: true, opacity: 0.6 }));
  floss.position.set(x, 0.16, z);
  floss.rotation.x = Math.PI/2;
  scene.add(floss);
}
function addMirrorProp(x, z) {
  const steel = new THREE.MeshStandardMaterial({ color: 0xd9d9e6, metalness: 0.95, roughness: 0.15 });
  const handle = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 1.0, 10), steel);
  handle.position.set(x, 0.12, z);
  handle.rotation.z = Math.PI/2;
  handle.castShadow = true;
  scene.add(handle);
  const head = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 0.05, 18), steel);
  head.position.set(x + 0.55, 0.14, z);
  head.rotation.x = Math.PI/2;
  scene.add(head);
  const glass = new THREE.Mesh(new THREE.CircleGeometry(0.18, 20), new THREE.MeshBasicMaterial({ color: 0x88ccff, transparent: true, opacity: 0.35 }));
  glass.position.set(x + 0.57, 0.14, z);
  glass.rotation.y = Math.PI/2;
  scene.add(glass);
}

function buildPath(hw, hh) {
  const pathPts = PATH; // use the active map's path
  if (!pathPts) return;

  const isBakery = theme === 'bakery';
  const isDentist = theme === 'dentist';

  const tileH = 0.12;
  const tileGeo = new THREE.BoxGeometry(1.0, tileH, 1.0, 1, 1, 1);

  const glossy = new THREE.MeshStandardMaterial({
    color: isBakery ? 0xff7ac0 : 0x7fe9ff,
    roughness: 0.25,
    metalness: 0.05,
    emissive: isBakery ? 0x7a1b40 : 0x0a3a40,
    emissiveIntensity: 0.35
  });

  const haloMat = new THREE.MeshBasicMaterial({
    color: isBakery ? 0xff4fa3 : 0x22c7c5,
    transparent: true,
    opacity: 0.28,
    depthWrite: false
  });

  const sprinkleColors = [0xff4fa3,0xf59e0b,0x22c7c5,0xa855f7,0x60a5fa,0xef4444];

  pathPts.forEach((p, idx) => {
    const x = p[0] - hw + 0.5;
    const z = p[1] - hh + 0.5;

    // Main tile
    const tile = new THREE.Mesh(tileGeo, glossy);
    tile.position.set(x, tileH/2, z);
    tile.castShadow = true;
    tile.receiveShadow = true;
    scene.add(tile);

    // Rounded edge illusion (slightly inset top)
    const cap = new THREE.Mesh(new THREE.BoxGeometry(0.92, 0.02, 0.92), new THREE.MeshStandardMaterial({
      color: glossy.color, roughness: 0.15, metalness: 0.02,
      emissive: glossy.emissive, emissiveIntensity: 0.25
    }));
    cap.position.set(x, tileH + 0.01, z);
    scene.add(cap);

    // Glow halo underneath
    const halo = new THREE.Mesh(new THREE.PlaneGeometry(1.25, 1.25), haloMat);
    halo.rotation.x = -Math.PI/2;
    halo.position.set(x, 0.01, z);
    scene.add(halo);

    // Sprinkles / sparkles every 3rd tile
    if (idx % 3 === 2) {
      const count = 10;
      for (let i = 0; i < count; i++) {
        const c = sprinkleColors[(idx + i) % sprinkleColors.length];
        const mat = new THREE.MeshStandardMaterial({
          color: c, roughness: 0.35, metalness: 0.05,
          emissive: c, emissiveIntensity: 0.15
        });
        const sprinkle = new THREE.Mesh(
          isBakery ? new THREE.CylinderGeometry(0.03, 0.03, 0.12, 8) : new THREE.BoxGeometry(0.08, 0.02, 0.02),
          mat
        );
        sprinkle.position.set(
          x + (Math.random()-0.5)*0.7,
          tileH + 0.03 + Math.random()*0.04,
          z + (Math.random()-0.5)*0.7
        );
        sprinkle.rotation.set(Math.random()*Math.PI, Math.random()*Math.PI, Math.random()*Math.PI);
        scene.add(sprinkle);
      }
    }
  });

  // Spawn marker + base marker (theme-specific)
  const start = pathPts[0], end = pathPts[pathPts.length-1];
  if (start) addMarker(start[0]-hw+0.5, start[1]-hh+0.5, isBakery ? 'cupcake' : 'chair');
  if (end)   addMarker(end[0]-hw+0.5,   end[1]-hh+0.5,   isBakery ? 'trophy'  : 'tooth');
}

function addMarker(x, z, kind) {
  if (kind === 'cupcake') {
    const wrapper = new THREE.Mesh(new THREE.CylinderGeometry(0.32, 0.38, 0.25, 16), new THREE.MeshStandardMaterial({ color: 0xff9ad1, roughness: 0.7, metalness: 0.0 }));
    wrapper.position.set(x, 0.13, z); wrapper.castShadow = true; scene.add(wrapper);
    const frosting = new THREE.Mesh(new THREE.SphereGeometry(0.35, 16, 14), new THREE.MeshStandardMaterial({ color: 0xff7ac0, roughness: 0.25, metalness: 0.05, emissive: 0x7a1b40, emissiveIntensity: 0.25 }));
    frosting.position.set(x, 0.32, z); frosting.scale.y = 0.8; frosting.castShadow = true; scene.add(frosting);
    const cherry = new THREE.Mesh(new THREE.SphereGeometry(0.09, 12, 12), new THREE.MeshStandardMaterial({ color: 0xef4444, roughness: 0.35, metalness: 0.1 }));
    cherry.position.set(x, 0.55, z); cherry.castShadow = true; scene.add(cherry);
  } else if (kind === 'trophy') {
    const gold = new THREE.MeshStandardMaterial({ color: 0xfbbf24, metalness: 0.95, roughness: 0.22, emissive: 0x2a1a00, emissiveIntensity: 0.15 });
    const base = new THREE.Mesh(new THREE.CylinderGeometry(0.42, 0.5, 0.25, 18), gold);
    base.position.set(x, 0.13, z); base.castShadow = true; scene.add(base);
    const cup = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.28, 0.35, 18), gold);
    cup.position.set(x, 0.38, z); cup.castShadow = true; scene.add(cup);
    [-1,1].forEach(s => {
      const h = new THREE.Mesh(new THREE.TorusGeometry(0.22, 0.04, 10, 16, Math.PI), gold);
      h.position.set(x + 0.28*s, 0.42, z);
      h.rotation.z = s>0 ? Math.PI/2 : -Math.PI/2;
      scene.add(h);
    });
  } else if (kind === 'chair') {
    const seat = new THREE.Mesh(new THREE.BoxGeometry(0.8,0.18,0.55), new THREE.MeshLambertMaterial({ color: 0x93c5fd }));
    seat.position.set(x, 0.12, z); seat.castShadow = true; scene.add(seat);
    const back = new THREE.Mesh(new THREE.BoxGeometry(0.7,0.35,0.14), new THREE.MeshLambertMaterial({ color: 0x60a5fa }));
    back.position.set(x-0.05, 0.33, z-0.2); back.rotation.x = -0.25; back.castShadow = true; scene.add(back);
  } else if (kind === 'tooth') {
    const enamel = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.35, metalness: 0.0, emissive: 0x0a1014, emissiveIntensity: 0.05 });
    const tooth = makeCapsule(0.25, 0.35, enamel);
    tooth.position.set(x, 0.28, z);
    scene.add(tooth);
    const crown = new THREE.Mesh(new THREE.SphereGeometry(0.18, 12, 12), enamel);
    crown.position.set(x, 0.52, z); crown.scale.y = 0.8; scene.add(crown);
  }
}

function addSpawnAndPenVisuals(hw, hh) {
  // Multiple spawn portals (enemy side) + a "pen" end zone (defender side)
  const portalMat = new THREE.MeshStandardMaterial({ color: 0x9b1c1c, roughness: 0.45, metalness: 0.25, emissive: 0x220000 });
  const ringMat   = new THREE.MeshStandardMaterial({ color: 0x111827, roughness: 0.55, metalness: 0.35 });
  const fenceMat  = new THREE.MeshStandardMaterial({ color: 0xd1d5db, roughness: 0.5, metalness: 0.35 });

  // Spawn portals
  for (const s of SPAWNS) {
    const px = s.x - hw + 0.5;
    const pz = s.y - hh + 0.5;

    const ring = new THREE.Mesh(new THREE.TorusGeometry(0.55, 0.10, 10, 18), ringMat);
    ring.position.set(px - 0.25, 0.12, pz);
    ring.rotation.x = Math.PI / 2;
    scene.add(ring);

    const glow = new THREE.Mesh(new THREE.CylinderGeometry(0.38, 0.38, 0.10, 14), portalMat);
    glow.position.set(px - 0.25, 0.10, pz);
    scene.add(glow);

    const post = new THREE.Mesh(new THREE.BoxGeometry(0.10, 0.55, 0.10), fenceMat);
    post.position.set(px - 0.85, 0.38, pz);
    scene.add(post);
  }

  // Pen at BASE (end point) — make it look like a real “holding pen” / goal corral
  const bx = BASE.x - hw + 0.5;
  const bz = BASE.y - hh + 0.5;

  const isBakery = theme === 'bakery';

  // Pen group (so it’s easy to move/scale)
  const penG = new THREE.Group();
  penG.position.set(bx, 0, bz);
  scene.add(penG);

  // Pen floor plate (slightly inset so it reads as an area)
  const plateMat = new THREE.MeshStandardMaterial({
    color: isBakery ? 0xd1d5db : 0xdbeafe,
    roughness: 0.75,
    metalness: 0.05
  });
  const plate = new THREE.Mesh(new THREE.BoxGeometry(1.75, 0.06, 1.65), plateMat);
  plate.position.set(-0.55, 0.03, 0);
  plate.receiveShadow = true;
  penG.add(plate);

  // Fence: posts + rails (open on the right edge because BASE is on the right boundary)
  const postMat = new THREE.MeshStandardMaterial({ color: 0x6b4f2f, roughness: 0.75, metalness: 0.05 });
  const railMat = new THREE.MeshStandardMaterial({ color: 0x8b5e34, roughness: 0.70, metalness: 0.05 });
  const postGeo = new THREE.CylinderGeometry(0.07, 0.09, 0.62, 10);
  const railGeoH = new THREE.BoxGeometry(1.55, 0.10, 0.10);
  const railGeoV = new THREE.BoxGeometry(0.10, 0.10, 1.55);

  const addPost = (x,z) => {
    const p = new THREE.Mesh(postGeo, postMat);
    p.position.set(x, 0.31, z);
    p.castShadow = true;
    penG.add(p);
  };
  const addRail = (geo, x,y,z) => {
    const r = new THREE.Mesh(geo, railMat);
    r.position.set(x, y, z);
    r.castShadow = true;
    penG.add(r);
  };

  // Rectangle around the plate (left/top/bottom), leave right side open
  const leftX = -1.30, rightX = 0.20, topZ = -0.80, botZ = 0.80;
  addPost(leftX, topZ); addPost(leftX, botZ);
  addPost(rightX, topZ); addPost(rightX, botZ);

  // rails (two heights)
  addRail(railGeoH, (leftX+rightX)/2, 0.22, topZ);
  addRail(railGeoH, (leftX+rightX)/2, 0.44, topZ);
  addRail(railGeoH, (leftX+rightX)/2, 0.22, botZ);
  addRail(railGeoH, (leftX+rightX)/2, 0.44, botZ);

  addRail(railGeoV, leftX, 0.22, 0);
  addRail(railGeoV, leftX, 0.44, 0);

  // “Goal sign” hanging on the left fence
  const signMat = new THREE.MeshStandardMaterial({ color: isBakery ? 0xf59e0b : 0x38bdf8, roughness: 0.6, metalness: 0.08 });
  const sign = new THREE.Mesh(new THREE.BoxGeometry(0.62, 0.34, 0.06), signMat);
  sign.position.set(leftX + 0.24, 0.46, 0);
  sign.rotation.y = Math.PI/2;
  sign.castShadow = true;
  penG.add(sign);

  // Contents: swapped per your rule
  // Bakery map pen: teeth. Dentist map pen: macarons + sugar cubes.
  const teethMat = new THREE.MeshStandardMaterial({ color: 0xf8fafc, roughness: 0.35, metalness: 0.02 });
  const macMatA  = new THREE.MeshStandardMaterial({ color: 0xfca5a5, roughness: 0.55, metalness: 0.02 });
  const macMatB  = new THREE.MeshStandardMaterial({ color: 0xa7f3d0, roughness: 0.55, metalness: 0.02 });
  const macMatC  = new THREE.MeshStandardMaterial({ color: 0xbfdbfe, roughness: 0.55, metalness: 0.02 });
  const sugarMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.85, metalness: 0.01 });

  const rng = mulberry32((((mapIndex+1) * 10007) + (isBakery ? 123 : 456))>>>0);

  const toothGeo1 = new THREE.SphereGeometry(0.14, 10, 10);
  const toothGeo2 = new THREE.CylinderGeometry(0.17, 0.11, 0.24, 10);
  const sugarGeo = new THREE.BoxGeometry(0.18, 0.18, 0.18);
  const macTopGeo = new THREE.CylinderGeometry(0.18, 0.18, 0.08, 12);
  const macFillGeo = new THREE.CylinderGeometry(0.17, 0.17, 0.05, 12);
  const macFillMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.6, metalness: 0.0 });

  const addTooth = (x,z,rot) => {
    const g = new THREE.Group();
    const s1 = new THREE.Mesh(toothGeo1, teethMat);
    const s2 = new THREE.Mesh(toothGeo1, teethMat);
    s1.position.set(-0.09, 0.14, 0);
    s2.position.set( 0.09, 0.14, 0);
    const crown = new THREE.Mesh(toothGeo2, teethMat);
    crown.position.set(0, 0.30, 0);
    g.add(s1); g.add(s2); g.add(crown);
    g.position.set(x, 0.06, z);
    g.rotation.y = rot;
    g.traverse(o=>{ if(o.isMesh){ o.castShadow=true; } });
    penG.add(g);
  };

  const addMacaron = (x,z,mat) => {
    const g = new THREE.Group();
    const top = new THREE.Mesh(macTopGeo, mat);
    const bot = new THREE.Mesh(macTopGeo, mat);
    const fill = new THREE.Mesh(macFillGeo, macFillMat);
    top.position.y = 0.14;
    bot.position.y = 0.06;
    fill.position.y = 0.10;
    g.add(bot); g.add(fill); g.add(top);
    g.position.set(x, 0.05, z);
    g.rotation.y = rng() * Math.PI * 2;
    g.traverse(o=>{ if(o.isMesh){ o.castShadow=true; } });
    penG.add(g);
  };

  const addSugar = (x,z) => {
    const c = new THREE.Mesh(sugarGeo, sugarMat);
    c.position.set(x, 0.10, z);
    c.rotation.y = rng() * Math.PI * 2;
    c.castShadow = true;
    penG.add(c);
  };

  // Fill area (pile) inside the corral
  for (let i = 0; i < 18; i++) {
    const ox = (rng() - 0.5) * 1.00;
    const oz = (rng() - 0.5) * 1.05;
    const x = -0.55 + ox; // relative to penG
    const z = oz;

    if (isBakery) {
      addTooth(x, z, rng() * Math.PI * 2);
    } else {
      const r = rng();
      if (r < 0.65) {
        const mats = [macMatA, macMatB, macMatC];
        addMacaron(x, z, mats[Math.floor(rng() * mats.length)]);
      } else {
        addSugar(x, z);
      }
    }
  }

}

function buildCells(hw, hh) {
  for (let y = 0; y < ROWS; y++) {
    for (let x = 0; x < COLS; x++) {
      const cell = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), new THREE.MeshBasicMaterial({ transparent: true, opacity: 0 }));
      cell.rotation.x = -Math.PI/2;
      cell.position.set(x - hw + 0.5, 0.22, y - hh + 0.5);
      cell.userData = { x, y, isCell: true };
      scene.add(cell);
      cells.push(cell);
    }
  }
}

function buildLights(hw, hh) {
  [[-hw-3, -hh-3], [-hw-3, hh+3], [hw+3, -hh-3], [hw+3, hh+3]].forEach(([x, z]) => {
    const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.15, 0.2, 8, 8), new THREE.MeshLambertMaterial({ color: 0x333333 }));
    pole.position.set(x, 4, z);
    scene.add(pole);
    const light = new THREE.Mesh(new THREE.BoxGeometry(1.4, 0.25, 1.4), new THREE.MeshBasicMaterial({ color: 0xffffdd }));
    light.position.set(x, 8.15, z);
    scene.add(light);
  });
}

// ========================================
// ENHANCED TOWER CREATION - MUCH BETTER!
// ========================================
function makeCapsule(radius, height, material, radialSegments=12) {
  // three.js r128 does not include CapsuleGeometry; build one from a cylinder + two spheres.
  const g = new THREE.Group();
  const cylH = Math.max(0.0001, height);
  const cyl = new THREE.Mesh(new THREE.CylinderGeometry(radius, radius, cylH, radialSegments), material);
  cyl.castShadow = true; cyl.receiveShadow = true;
  g.add(cyl);

  const sphTop = new THREE.Mesh(new THREE.SphereGeometry(radius, radialSegments, Math.max(8, Math.floor(radialSegments*0.75))), material);
  sphTop.position.y = cylH/2;
  sphTop.castShadow = true; sphTop.receiveShadow = true;
  g.add(sphTop);

  const sphBot = new THREE.Mesh(new THREE.SphereGeometry(radius, radialSegments, Math.max(8, Math.floor(radialSegments*0.75))), material);
  sphBot.position.y = -cylH/2;
  sphBot.castShadow = true; sphBot.receiveShadow = true;
  g.add(sphBot);

  return g;
}

function createTowerMesh(tower) {
  const td = themeData.towers.find(t => t.id === tower.type);
  const color = new THREE.Color(td.clr);
  const group = new THREE.Group();
  const hw = COLS/2, hh = ROWS/2;
  const lv = tower.lv || 0;
  const scale = 1 + lv * 0.08; // Towers grow slightly with level
  
  // Materials
  const baseMat = new THREE.MeshStandardMaterial({ color: 0x1a1a2e, metalness: 0.3, roughness: 0.7 });
  const bodyMat = new THREE.MeshStandardMaterial({ color, metalness: 0.4, roughness: 0.5 });
  const glowMat = new THREE.MeshBasicMaterial({ color });
  const metalMat = new THREE.MeshStandardMaterial({ color: 0x888899, metalness: 0.8, roughness: 0.2 });
  const darkMat = new THREE.MeshStandardMaterial({ color: 0x222233, metalness: 0.5, roughness: 0.5 });
  const whiteMat = new THREE.MeshStandardMaterial({ color: 0xffffff, metalness: 0.1, roughness: 0.8 });
  const goldMat = new THREE.MeshStandardMaterial({ color: 0xffd700, metalness: 0.9, roughness: 0.1 });
  
  // === HEXAGONAL BASE PLATFORM ===
  const baseShape = new THREE.CylinderGeometry(0.4 * scale, 0.45 * scale, 0.12, 6);
  const base = new THREE.Mesh(baseShape, baseMat);
  base.position.y = 0.06;
  base.castShadow = true;
  base.receiveShadow = true;
  group.add(base);
  
  // Base rim glow
  const baseRim = new THREE.Mesh(new THREE.TorusGeometry(0.42 * scale, 0.025, 8, 6), glowMat);
  baseRim.rotation.x = Math.PI/2;
  baseRim.position.y = 0.12;
  group.add(baseRim);
  
  // Level indicator stars
  for (let i = 0; i <= lv; i++) {
    const star = new THREE.Mesh(new THREE.OctahedronGeometry(0.04, 0), goldMat);
    const angle = (i / 4) * Math.PI * 2 - Math.PI/2;
    star.position.set(Math.cos(angle) * 0.35 * scale, 0.14, Math.sin(angle) * 0.35 * scale);
    star.rotation.y = Math.PI/4;
    group.add(star);
  }
  
  // Build tower based on type
  const towerIdx = parseInt(tower.type.substring(1)) - 1;
  
  if (theme === 'bakery') {
    buildBakeryTowerMesh(group, towerIdx, scale, bodyMat, glowMat, metalMat, darkMat, whiteMat, goldMat, color);
  } else {
    buildDentistTowerMesh(group, towerIdx, scale, bodyMat, glowMat, metalMat, darkMat, whiteMat, goldMat, color);
  }
  
  // Range indicator
  const range = new THREE.Mesh(
    new THREE.RingGeometry(tower.rng - 0.05, tower.rng, 64),
    new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.15, side: THREE.DoubleSide })
  );
  range.rotation.x = -Math.PI/2;
  range.position.y = 0.02;
  group.add(range);
  tower.rangeMesh = range;
  
  group.position.set(tower.x - hw + 0.5, 0.08, tower.y - hh + 0.5);
  scene.add(group);
  tower.animParts = group.userData.animParts || [];
  return group;
}

function buildBakeryTowerMesh(group, idx, scale, bodyMat, glowMat, metalMat, darkMat, whiteMat, goldMat, color) {
  group.userData.animParts = group.userData.animParts || [];
  const woodMat = new THREE.MeshStandardMaterial({ color: 0xb07a3a, roughness: 0.85, metalness: 0.05 });
  const pinkMat = new THREE.MeshStandardMaterial({ color: 0xff7ac0, roughness: 0.25, metalness: 0.05, emissive: 0x7a1b40, emissiveIntensity: 0.2 });
  const chromeMat = new THREE.MeshStandardMaterial({ color: 0xcfd3df, roughness: 0.15, metalness: 0.95 });

  switch(idx) {
    // 🥣 Mixer
    case 0: {
      const bowl = new THREE.Mesh(new THREE.CylinderGeometry(0.32*scale, 0.42*scale, 0.28*scale, 22), chromeMat);
      bowl.position.y = 0.28*scale; bowl.castShadow = true; group.add(bowl);

      const arm = new THREE.Mesh(new THREE.BoxGeometry(0.55*scale, 0.1*scale, 0.18*scale), whiteMat);
      arm.position.set(0, 0.55*scale, 0); arm.castShadow = true; group.add(arm);

      const whiskG = new THREE.Group();
      const shaft = new THREE.Mesh(new THREE.CylinderGeometry(0.03*scale, 0.03*scale, 0.22*scale, 10), chromeMat);
      shaft.position.y = 0.44*scale; whiskG.add(shaft);
      for (let i=0;i<6;i++){
        const loop = new THREE.Mesh(new THREE.TorusGeometry(0.06*scale, 0.01*scale, 8, 16), chromeMat);
        loop.position.y = 0.34*scale + i*0.02*scale;
        loop.rotation.x = Math.PI/2;
        loop.rotation.z = i * 0.35;
        whiskG.add(loop);
      }
      whiskG.position.set(0, 0, 0);
      group.add(whiskG);
      group.userData.animParts.push({ type:'spin', mesh: whiskG, speed: 1.8 });
      break;
    }

    // 🥄 Huge Spoon
    case 1: {
      const handle = new THREE.Mesh(new THREE.CylinderGeometry(0.07*scale, 0.07*scale, 0.85*scale, 14), woodMat);
      handle.position.y = 0.5*scale; handle.castShadow = true; group.add(handle);

      const head = new THREE.Mesh(new THREE.SphereGeometry(0.18*scale, 16, 14), woodMat);
      head.scale.set(1.6, 0.8, 1.0);
      head.position.y = 0.95*scale; head.castShadow = true; group.add(head);
      group.userData.animParts.push({ type:'float', mesh: head, offset: 0.3 });
      break;
    }

    // 🪵 Rolling Pin (AOE)
    case 2: {
      const pin = new THREE.Mesh(new THREE.CylinderGeometry(0.17*scale, 0.17*scale, 0.7*scale, 18), woodMat);
      pin.position.y = 0.48*scale; pin.rotation.z = Math.PI/2; pin.castShadow = true; group.add(pin);
      [-1,1].forEach(s=>{
        const h = new THREE.Mesh(new THREE.CylinderGeometry(0.08*scale, 0.08*scale, 0.18*scale, 14), woodMat);
        h.position.set(0.45*scale*s, 0.48*scale, 0); h.rotation.z = Math.PI/2; h.castShadow = true; group.add(h);
      });
      const ring = new THREE.Mesh(new THREE.TorusGeometry(0.32*scale, 0.03*scale, 10, 28), glowMat);
      ring.position.y = 0.2*scale; ring.rotation.x = Math.PI/2; group.add(ring);
      group.userData.animParts.push({ type:'pulse', mesh: ring, offset: 0.2 });
      break;
    }

    // 🧤 Oven Mitts (slow)
    case 3: {
      const mittMat = new THREE.MeshStandardMaterial({ color: 0x38bdf8, roughness: 0.85, metalness: 0.05, emissive: 0x0b2a3a, emissiveIntensity: 0.15 });
      [-1,1].forEach(s=>{
        const mitt = new THREE.Mesh(new THREE.BoxGeometry(0.26*scale, 0.34*scale, 0.18*scale), mittMat);
        mitt.position.set(0.17*scale*s, 0.42*scale, 0);
        mitt.rotation.y = 0.25*s;
        mitt.castShadow = true;
        group.add(mitt);
        group.userData.animParts.push({ type:'float', mesh: mitt, offset: s*0.6 });
      });
      break;
    }

    // 🎂 Piping Bags
    case 4: {
      const bag = new THREE.Mesh(new THREE.ConeGeometry(0.28*scale, 0.62*scale, 18), pinkMat);
      bag.position.y = 0.55*scale; bag.rotation.x = Math.PI; bag.castShadow = true; group.add(bag);

      const nozzle = new THREE.Mesh(new THREE.CylinderGeometry(0.07*scale, 0.09*scale, 0.12*scale, 14), chromeMat);
      nozzle.position.y = 0.25*scale; nozzle.castShadow = true; group.add(nozzle);

      const glow = new THREE.Mesh(new THREE.SphereGeometry(0.13*scale, 12, 10), glowMat);
      glow.position.y = 0.18*scale; group.add(glow);
      group.userData.animParts.push({ type:'pulse', mesh: glow, offset: 0.1 });
      break;
    }

    // 🍬 Sprinkle Gatling (multishot/chain)
    case 5: {
      const base = new THREE.Mesh(new THREE.CylinderGeometry(0.22*scale, 0.28*scale, 0.35*scale, 16), darkMat);
      base.position.y = 0.3*scale; base.castShadow = true; group.add(base);

      const barrelG = new THREE.Group();
      const colors = [0xff4fa3,0xf59e0b,0x22c7c5,0xa855f7,0x60a5fa,0xef4444];
      for (let i=0;i<6;i++){
        const tube = new THREE.Mesh(new THREE.CylinderGeometry(0.06*scale,0.06*scale,0.42*scale,12),
          new THREE.MeshStandardMaterial({ color: colors[i], roughness: 0.35, metalness: 0.1, emissive: colors[i], emissiveIntensity: 0.12 })
        );
        const a = i*(Math.PI*2/6);
        tube.position.set(Math.cos(a)*0.14*scale, 0.5*scale, Math.sin(a)*0.14*scale);
        tube.rotation.x = Math.PI/2;
        tube.castShadow = true;
        barrelG.add(tube);
      }
      barrelG.position.y = 0.08*scale;
      group.add(barrelG);
      group.userData.animParts.push({ type:'spin', mesh: barrelG, speed: 2.3 });
      break;
    }

    // 🔥 Caramel Torch (burn)
    case 6: {
      const can = new THREE.Mesh(new THREE.CylinderGeometry(0.18*scale, 0.2*scale, 0.45*scale, 18), metalMat);
      can.position.y = 0.34*scale; can.castShadow = true; group.add(can);
      const nozzle = new THREE.Mesh(new THREE.BoxGeometry(0.2*scale,0.08*scale,0.12*scale), darkMat);
      nozzle.position.set(0,0.6*scale,0); nozzle.castShadow = true; group.add(nozzle);

      const flame = new THREE.Mesh(new THREE.ConeGeometry(0.12*scale, 0.26*scale, 10), new THREE.MeshBasicMaterial({ color: 0xffc14d }));
      flame.position.set(0,0.72*scale,0);
      group.add(flame);
      group.userData.animParts.push({ type:'flame', mesh: flame, offset: 0.4 });
      break;
    }

    // 🏆 Golden Trophy (heavy hit / crit)
    case 7: {
      const base = new THREE.Mesh(new THREE.CylinderGeometry(0.25*scale, 0.33*scale, 0.22*scale, 18), goldMat);
      base.position.y = 0.22*scale; base.castShadow = true; group.add(base);
      const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.12*scale, 0.12*scale, 0.18*scale, 14), goldMat);
      stem.position.y = 0.4*scale; group.add(stem);
      const cup = new THREE.Mesh(new THREE.CylinderGeometry(0.28*scale, 0.22*scale, 0.32*scale, 18), goldMat);
      cup.position.y = 0.6*scale; cup.castShadow = true; group.add(cup);
      [-1,1].forEach(s=>{
        const h = new THREE.Mesh(new THREE.TorusGeometry(0.18*scale, 0.035*scale, 10, 16, Math.PI), goldMat);
        h.position.set(0.22*scale*s, 0.62*scale, 0);
        h.rotation.z = s>0 ? Math.PI/2 : -Math.PI/2;
        group.add(h);
      });
      const shine = new THREE.Mesh(new THREE.SphereGeometry(0.08*scale, 10, 10), glowMat);
      shine.position.set(0,0.75*scale,0.12*scale);
      group.add(shine);
      group.userData.animParts.push({ type:'pulse', mesh: shine, offset: 0.8 });
      break;
    }
  }
}

function buildDentistTowerMesh(group, idx, scale, bodyMat, glowMat, metalMat, darkMat, whiteMat, goldMat, color) {
  group.userData.animParts = group.userData.animParts || [];
  const steel = new THREE.MeshStandardMaterial({ color: 0xcfd3df, metalness: 0.95, roughness: 0.15 });
  const tealGlow = new THREE.MeshBasicMaterial({ color: 0x22c7c5 });
  const enamel = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.35, metalness: 0.0 });

  switch(idx) {
    // 🛠️ Dental Drill
    case 0: {
      const body = new THREE.Mesh(new THREE.CylinderGeometry(0.14*scale, 0.16*scale, 0.55*scale, 18), bodyMat);
      body.position.y = 0.44*scale; body.castShadow = true; group.add(body);
      const tip = new THREE.Mesh(new THREE.CylinderGeometry(0.06*scale, 0.06*scale, 0.12*scale, 12), steel);
      tip.position.y = 0.72*scale; group.add(tip);

      const burr = new THREE.Mesh(new THREE.CylinderGeometry(0.03*scale,0.03*scale,0.16*scale,10), steel);
      burr.position.y = 0.84*scale; burr.rotation.x = Math.PI/2; group.add(burr);
      group.userData.animParts.push({ type:'spin', mesh: burr, speed: 3.2 });
      break;
    }

    // 📸 X‑Ray Sniper
    case 1: {
      const cam = new THREE.Mesh(new THREE.BoxGeometry(0.45*scale, 0.22*scale, 0.28*scale), darkMat);
      cam.position.y = 0.52*scale; cam.castShadow = true; group.add(cam);
      const lens = new THREE.Mesh(new THREE.CylinderGeometry(0.09*scale, 0.11*scale, 0.18*scale, 14), steel);
      lens.position.set(0, 0.52*scale, 0.22*scale); lens.rotation.x = Math.PI/2; group.add(lens);

      const ret = new THREE.Mesh(new THREE.RingGeometry(0.08*scale, 0.12*scale, 18), tealGlow);
      ret.position.set(0, 0.52*scale, 0.32*scale); ret.rotation.y = Math.PI; group.add(ret);
      group.userData.animParts.push({ type:'pulse', mesh: ret, offset: 0.2 });
      break;
    }

    // 🪝 Scaler Smash (AOE)
    case 2: {
      const handle = new THREE.Mesh(new THREE.CylinderGeometry(0.07*scale, 0.07*scale, 0.85*scale, 14), steel);
      handle.position.y = 0.52*scale; handle.castShadow = true; group.add(handle);
      const hook = new THREE.Mesh(new THREE.TorusGeometry(0.16*scale, 0.03*scale, 10, 20, Math.PI*1.2), steel);
      hook.position.y = 0.95*scale; hook.rotation.x = Math.PI/2; hook.rotation.z = Math.PI/2; group.add(hook);

      const shock = new THREE.Mesh(new THREE.TorusGeometry(0.3*scale, 0.025*scale, 10, 24), tealGlow);
      shock.position.y = 0.18*scale; shock.rotation.x = Math.PI/2; group.add(shock);
      group.userData.animParts.push({ type:'pulse', mesh: shock, offset: 0.5 });
      break;
    }

    // 💨 Freeze Spray (slow)
    case 3: {
      const can = new THREE.Mesh(new THREE.CylinderGeometry(0.16*scale, 0.18*scale, 0.5*scale, 18), whiteMat);
      can.position.y = 0.4*scale; can.castShadow = true; group.add(can);
      const head = new THREE.Mesh(new THREE.BoxGeometry(0.2*scale,0.1*scale,0.22*scale), steel);
      head.position.y = 0.68*scale; group.add(head);
      const mist = new THREE.Mesh(new THREE.SphereGeometry(0.16*scale, 12, 10), tealGlow);
      mist.position.set(0,0.68*scale,0.22*scale);
      group.add(mist);
      group.userData.animParts.push({ type:'blink', mesh: mist });
      break;
    }

    // 🧪 Suction Guard (heavy)
    case 4: {
      const jar = new THREE.Mesh(new THREE.CylinderGeometry(0.18*scale, 0.2*scale, 0.48*scale, 16),
        new THREE.MeshStandardMaterial({ color: 0x7fe9ff, transparent:true, opacity:0.75, roughness:0.25, metalness:0.05, emissive: 0x0a3a40, emissiveIntensity: 0.15 })
      );
      jar.position.y = 0.42*scale; jar.castShadow = true; group.add(jar);
      const lid = new THREE.Mesh(new THREE.CylinderGeometry(0.2*scale, 0.2*scale, 0.07*scale, 14), steel);
      lid.position.y = 0.69*scale; group.add(lid);
      const tube = new THREE.Mesh(new THREE.TorusGeometry(0.22*scale, 0.03*scale, 8, 22, Math.PI), steel);
      tube.position.y = 0.68*scale; tube.rotation.x = Math.PI/2; tube.rotation.z = Math.PI/2; group.add(tube);
      group.userData.animParts.push({ type:'float', mesh: jar, offset: 0.7 });
      break;
    }

    // 🧵 Floss Arc (chain)
    case 5: {
      [-1,1].forEach(s=>{
        const post = new THREE.Mesh(new THREE.CylinderGeometry(0.06*scale,0.06*scale,0.7*scale,12), steel);
        post.position.set(0.22*scale*s, 0.5*scale, 0);
        post.castShadow = true; group.add(post);
      });
      const floss = new THREE.Mesh(new THREE.TorusGeometry(0.28*scale, 0.015*scale, 8, 30), tealGlow);
      floss.position.y = 0.65*scale; floss.rotation.x = Math.PI/2; group.add(floss);
      group.userData.animParts.push({ type:'orbit', mesh: floss, radius: 0.0, offset: 0.0 }); // uses orbit to wiggle
      break;
    }

    // 🧴 Fluoride Burn (DoT)
    case 6: {
      const bottle = new THREE.Mesh(new THREE.CylinderGeometry(0.16*scale,0.18*scale,0.52*scale,14),
        new THREE.MeshStandardMaterial({ color: 0xef4444, roughness:0.35, metalness:0.1, emissive:0x3a0606, emissiveIntensity:0.2 })
      );
      bottle.position.y = 0.44*scale; bottle.castShadow = true; group.add(bottle);
      const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.12*scale,0.12*scale,0.1*scale,12), whiteMat);
      cap.position.y = 0.75*scale; group.add(cap);

      const drips = new THREE.Group();
      for (let i=0;i<4;i++){
        const drop = new THREE.Mesh(new THREE.SphereGeometry(0.06*scale, 10, 10), new THREE.MeshBasicMaterial({ color: 0xff7a7a }));
        drop.position.set((Math.random()-0.5)*0.25*scale, 0.2*scale + i*0.08*scale, (Math.random()-0.5)*0.25*scale);
        drips.add(drop);
      }
      group.add(drips);
      group.userData.animParts.push({ type:'flame', mesh: drips, offset: 0.9 });
      break;
    }

    // 👑 Crown Laser (crit)
    case 7: {
      const crown = new THREE.Mesh(new THREE.ConeGeometry(0.28*scale, 0.35*scale, 8), goldMat);
      crown.position.y = 0.55*scale; crown.castShadow = true; group.add(crown);
      const band = new THREE.Mesh(new THREE.TorusGeometry(0.24*scale, 0.04*scale, 10, 18), goldMat);
      band.position.y = 0.42*scale; band.rotation.x = Math.PI/2; group.add(band);

      const gem = new THREE.Mesh(new THREE.OctahedronGeometry(0.09*scale, 0), new THREE.MeshBasicMaterial({ color: 0x7fe9ff }));
      gem.position.y = 0.62*scale; group.add(gem);
      group.userData.animParts.push({ type:'pulse', mesh: gem, offset: 0.4 });
      break;
    }
  }
}

// ========================================
// ENHANCED ENEMY CREATION
// ========================================
function createEnemyMesh(enemy) {
  const ed = themeData.enemies.find(e => e.id === enemy.type);
  const group = new THREE.Group();
  group.userData.animParts = group.userData.animParts || [];
  const s = (ed.sz || 1.0);
  const isBakery = theme === 'bakery';

  // Shared bounce for all enemies
  group.userData.animParts.push({ type:'float', mesh: group, offset: Math.random()*Math.PI });

  if (isBakery) {
    const cookieMat = new THREE.MeshStandardMaterial({ color: 0xd7a56a, roughness: 0.85, metalness: 0.02 });
    const chocoMat  = new THREE.MeshStandardMaterial({ color: 0x3b2416, roughness: 0.9, metalness: 0.0 });
    const frostingMat = new THREE.MeshStandardMaterial({ color: 0xff7ac0, roughness: 0.25, metalness: 0.05, emissive: 0x7a1b40, emissiveIntensity: 0.12 });
    const sprinkleCols = [0xff4fa3,0xf59e0b,0x22c7c5,0xa855f7,0x60a5fa,0xef4444];

    switch(ed.id) {
      // Cookie
      case 'e1': {
        const disc = new THREE.Mesh(new THREE.CylinderGeometry(0.38*s, 0.38*s, 0.14*s, 18), cookieMat);
        disc.position.y = 0.2*s; disc.castShadow = true; group.add(disc);
        for (let i=0;i<10;i++){
          const chip = new THREE.Mesh(new THREE.SphereGeometry(0.05*s, 10, 10), chocoMat);
          chip.position.set((Math.random()-0.5)*0.6*s, 0.27*s, (Math.random()-0.5)*0.6*s);
          chip.castShadow = true; group.add(chip);
        }
        break;
      }
      // Donut
      case 'e2': {
        const dough = new THREE.Mesh(new THREE.TorusGeometry(0.32*s, 0.14*s, 14, 22), cookieMat);
        dough.position.y = 0.28*s; dough.castShadow = true; group.add(dough);
        const icing = new THREE.Mesh(new THREE.TorusGeometry(0.32*s, 0.09*s, 12, 22), frostingMat);
        icing.position.y = 0.34*s;
        icing.scale.y = 0.6;
        group.add(icing);

        const sprG = new THREE.Group();
        for (let i=0;i<12;i++){
          const c = sprinkleCols[i % sprinkleCols.length];
          const spr = new THREE.Mesh(new THREE.CylinderGeometry(0.02*s,0.02*s,0.1*s,8),
            new THREE.MeshStandardMaterial({ color: c, roughness: 0.4, metalness: 0.05, emissive: c, emissiveIntensity: 0.1 })
          );
          const a = i*(Math.PI*2/12);
          spr.position.set(Math.cos(a)*0.32*s, 0.42*s, Math.sin(a)*0.32*s);
          spr.rotation.x = Math.random()*Math.PI;
          spr.rotation.z = Math.random()*Math.PI;
          sprG.add(spr);
        }
        group.add(sprG);
        group.userData.animParts.push({ type:'spin', mesh: sprG, speed: 2.2 });
        break;
      }
      // Cupcake
      case 'e3': {
        const wrap = new THREE.Mesh(new THREE.CylinderGeometry(0.26*s, 0.34*s, 0.28*s, 16), new THREE.MeshStandardMaterial({ color: 0xff9ad1, roughness: 0.75, metalness: 0.0 }));
        wrap.position.y = 0.2*s; wrap.castShadow = true; group.add(wrap);
        const top = new THREE.Mesh(new THREE.SphereGeometry(0.34*s, 16, 14), frostingMat);
        top.position.y = 0.48*s; top.scale.y = 0.75; top.castShadow = true; group.add(top);
        const cherry = new THREE.Mesh(new THREE.SphereGeometry(0.09*s, 12, 12), new THREE.MeshStandardMaterial({ color: 0xef4444, roughness: 0.35, metalness: 0.1 }));
        cherry.position.y = 0.72*s; cherry.castShadow = true; group.add(cherry);
        break;
      }
      // Gingerbread man
      case 'e4': {
        const gbMat = new THREE.MeshStandardMaterial({ color: 0xc17a3a, roughness: 0.9, metalness: 0.0 });
        const body = new THREE.Mesh(new THREE.BoxGeometry(0.45*s, 0.6*s, 0.2*s), gbMat);
        body.position.y = 0.45*s; body.castShadow = true; group.add(body);
        const head = new THREE.Mesh(new THREE.SphereGeometry(0.22*s, 14, 12), gbMat);
        head.position.y = 0.82*s; head.castShadow = true; group.add(head);
        // arms & legs
        [[0.38,0.52,0],[ -0.38,0.52,0],[0.17,0.15,0],[-0.17,0.15,0]].forEach(([x,y,z])=>{
          const limb = new THREE.Mesh(new THREE.CylinderGeometry(0.09*s,0.09*s,0.36*s,12), gbMat);
          limb.position.set(x*s,y*s,z*s);
          limb.rotation.z = Math.PI/2;
          limb.castShadow = true;
          group.add(limb);
        });
        // buttons
        const btnMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.6, metalness: 0.0 });
        [0.62,0.48,0.34].forEach(y=>{
          const btn = new THREE.Mesh(new THREE.SphereGeometry(0.04*s, 10, 10), btnMat);
          btn.position.set(0, y*s, 0.12*s);
          group.add(btn);
        });
        break;
      }
      // Macaron
      case 'e5': {
        const shellMat = new THREE.MeshStandardMaterial({ color: 0xf5c3e2, roughness: 0.6, metalness: 0.0 });
        const shell1 = new THREE.Mesh(new THREE.SphereGeometry(0.32*s, 18, 14), shellMat);
        shell1.position.y = 0.48*s; shell1.scale.y = 0.55; shell1.castShadow = true; group.add(shell1);
        const shell2 = shell1.clone();
        shell2.position.y = 0.23*s;
        group.add(shell2);
        const fill = new THREE.Mesh(new THREE.CylinderGeometry(0.29*s, 0.29*s, 0.18*s, 16), new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.55, metalness: 0.0 }));
        fill.position.y = 0.35*s; fill.castShadow = true; group.add(fill);
        break;
      }
      // Sugar Sprite (flying)
      case 'e6': {
        const candy = new THREE.Mesh(new THREE.SphereGeometry(0.22*s, 14, 14), new THREE.MeshStandardMaterial({ color: 0xa855f7, roughness: 0.35, metalness: 0.1, emissive: 0x2a0038, emissiveIntensity: 0.25 }));
        candy.position.y = 0.42*s; candy.castShadow = true; group.add(candy);
        [-1,1].forEach(side=>{
          const wing = new THREE.Mesh(new THREE.TorusGeometry(0.16*s, 0.03*s, 8, 16, Math.PI), new THREE.MeshBasicMaterial({ color: 0xffffff, transparent:true, opacity:0.35 }));
          wing.position.set(0.22*s*side, 0.42*s, 0);
          wing.rotation.z = side>0 ? Math.PI/2 : -Math.PI/2;
          group.add(wing);
        });
        group.userData.animParts.push({ type:'orbit', mesh: candy, radius: 0.02*s, offset: Math.random() });
        break;
      }
      // Cake Boss
      case 'e7': {
        const cakeMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.55, metalness: 0.0 });
        const tier1 = new THREE.Mesh(new THREE.CylinderGeometry(0.55*s,0.6*s,0.3*s,22), cakeMat);
        tier1.position.y = 0.25*s; tier1.castShadow = true; group.add(tier1);
        const tier2 = new THREE.Mesh(new THREE.CylinderGeometry(0.45*s,0.5*s,0.26*s,22), cakeMat);
        tier2.position.y = 0.55*s; tier2.castShadow = true; group.add(tier2);
        const tier3 = new THREE.Mesh(new THREE.CylinderGeometry(0.35*s,0.4*s,0.22*s,22), cakeMat);
        tier3.position.y = 0.8*s; tier3.castShadow = true; group.add(tier3);

        // 5 candles + flames
        const candleMat = new THREE.MeshStandardMaterial({ color: 0xff9ad1, roughness: 0.6, metalness: 0.0 });
        for (let i=0;i<5;i++){
          const a = i*(Math.PI*2/5);
          const candle = new THREE.Mesh(new THREE.CylinderGeometry(0.03*s,0.03*s,0.18*s,10), candleMat);
          candle.position.set(Math.cos(a)*0.18*s, 0.98*s, Math.sin(a)*0.18*s);
          group.add(candle);
          const flame = new THREE.Mesh(new THREE.ConeGeometry(0.05*s,0.12*s,10), new THREE.MeshBasicMaterial({ color: 0xffc14d }));
          flame.position.set(Math.cos(a)*0.18*s, 1.08*s, Math.sin(a)*0.18*s);
          group.add(flame);
          group.userData.animParts.push({ type:'flame', mesh: flame, offset: i*0.2 });
        }
        break;
      }
    }
  } else {
    // Dentist enemies
    const enamel = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.35, metalness: 0.0 });
    const plaqueMat = new THREE.MeshStandardMaterial({ color: 0x4ade80, roughness: 0.8, metalness: 0.0, emissive: 0x0a2a14, emissiveIntensity: 0.2 });
    const cavityMat = new THREE.MeshStandardMaterial({ color: 0x1f2937, roughness: 0.9, metalness: 0.0 });
    const tartarMat = new THREE.MeshStandardMaterial({ color: 0xd1d5db, roughness: 0.95, metalness: 0.0 });

    switch(ed.id) {
      // Tooth
      case 'e1': {
        const tooth = makeCapsule(0.22*s, 0.38*s, enamel);
        tooth.position.y = 0.42*s;
        group.add(tooth);
        const crown = new THREE.Mesh(new THREE.SphereGeometry(0.18*s, 12, 12), enamel);
        crown.position.y = 0.7*s; crown.scale.y = 0.8; group.add(crown);
        break;
      }
      // Plaque blob
      case 'e2': {
        const blob = new THREE.Mesh(new THREE.SphereGeometry(0.34*s, 14, 12), plaqueMat);
        blob.position.y = 0.42*s; blob.castShadow = true; group.add(blob);
        for (let i=0;i<6;i++){
          const bump = new THREE.Mesh(new THREE.SphereGeometry(0.12*s, 10, 10), plaqueMat);
          bump.position.set((Math.random()-0.5)*0.45*s, 0.35*s + Math.random()*0.25*s, (Math.random()-0.5)*0.45*s);
          group.add(bump);
        }
        group.userData.animParts.push({ type:'pulse', mesh: blob, offset: 0.4 });
        break;
      }
      // Cavity bug (flying)
      case 'e3': {
        const bug = new THREE.Mesh(new THREE.SphereGeometry(0.18*s, 12, 10), cavityMat);
        bug.position.y = 0.42*s; bug.castShadow = true; group.add(bug);
        const eye = new THREE.Mesh(new THREE.SphereGeometry(0.03*s, 8, 8), new THREE.MeshBasicMaterial({ color: 0xff4fa3 }));
        eye.position.set(0.06*s, 0.46*s, 0.14*s); group.add(eye);
        [-1,1].forEach(side=>{
          const wing = new THREE.Mesh(new THREE.PlaneGeometry(0.22*s, 0.12*s), new THREE.MeshBasicMaterial({ color: 0x7fe9ff, transparent:true, opacity:0.35, side:THREE.DoubleSide }));
          wing.position.set(0.18*s*side, 0.46*s, 0);
          wing.rotation.y = side>0 ? Math.PI/6 : -Math.PI/6;
          group.add(wing);
          group.userData.animParts.push({ type:'blink', mesh: wing });
        });
        break;
      }
      // Tartar chunk (armored)
      case 'e4': {
        const chunk = new THREE.Mesh(new THREE.DodecahedronGeometry(0.36*s, 0), tartarMat);
        chunk.position.y = 0.44*s; chunk.castShadow = true; group.add(chunk);
        group.userData.animParts.push({ type:'spin', mesh: chunk, speed: 0.6 });
        break;
      }
      // Infected molar
      case 'e5': {
        const tooth = makeCapsule(0.25*s, 0.42*s, enamel);
        tooth.position.y = 0.46*s;
        group.add(tooth);
        const sore = new THREE.Mesh(new THREE.SphereGeometry(0.12*s, 12, 10), new THREE.MeshStandardMaterial({ color: 0xef4444, roughness: 0.55, metalness: 0.0, emissive: 0x3a0606, emissiveIntensity: 0.3 }));
        sore.position.set(0.1*s, 0.38*s, 0.18*s);
        group.add(sore);
        group.userData.animParts.push({ type:'pulse', mesh: sore, offset: 0.2 });
        break;
      }
      // Germ swarm
      case 'e6': {
        const germ = new THREE.Mesh(new THREE.SphereGeometry(0.22*s, 14, 12), plaqueMat);
        germ.position.y = 0.42*s; germ.castShadow = true; group.add(germ);
        for (let i=0;i<8;i++){
          const spike = new THREE.Mesh(new THREE.ConeGeometry(0.04*s, 0.12*s, 8), plaqueMat);
          const a = i*(Math.PI*2/8);
          spike.position.set(Math.cos(a)*0.22*s, 0.42*s, Math.sin(a)*0.22*s);
          spike.rotation.x = Math.PI/2;
          group.add(spike);
        }
        group.userData.animParts.push({ type:'spin', mesh: germ, speed: 1.6 });
        break;
      }
      // Boss tooth
      case 'e7': {
        const tooth = makeCapsule(0.35*s, 0.6*s, enamel);
        tooth.position.y = 0.7*s;
        group.add(tooth);

        // braces wire + brackets
        const steel = new THREE.MeshStandardMaterial({ color: 0xcfd3df, metalness: 0.95, roughness: 0.15 });
        const wire = new THREE.Mesh(new THREE.TorusGeometry(0.32*s, 0.02*s, 8, 30, Math.PI), steel);
        wire.position.y = 0.7*s; wire.rotation.x = Math.PI/2; group.add(wire);
        for (let i=0;i<5;i++){
          const b = new THREE.Mesh(new THREE.BoxGeometry(0.08*s,0.06*s,0.04*s), steel);
          b.position.set((i-2)*0.11*s, 0.7*s, 0.3*s);
          group.add(b);
        }

        // "infection" holes flicker
        for (let i=0;i<5;i++){
          const hole = new THREE.Mesh(new THREE.SphereGeometry(0.06*s, 10, 10), new THREE.MeshBasicMaterial({ color: 0xef4444 }));
          hole.position.set((Math.random()-0.5)*0.35*s, 0.55*s + Math.random()*0.4*s, 0.25*s);
          group.add(hole);
          group.userData.animParts.push({ type:'blink', mesh: hole });
        }
        break;
      }
    }
  }

  enemy.animParts = group.userData.animParts;
  return group;
}

// Animation update for towers and enemies
function updateAnimations(dt) {
  const t = animTime;
  
  // Animate towers
  towers.forEach(tw => {
    if (!tw.animParts) return;
    tw.animParts.forEach(part => {
      if (!part.mesh) return;
      
      switch(part.type) {
        case 'pulse':
          const pulseScale = 1 + Math.sin(t * 4 + (part.offset || 0)) * 0.15;
          part.mesh.scale.setScalar(pulseScale);
          break;
        case 'spin':
          part.mesh.rotation.y += dt * (part.speed || 1) * 2;
          break;
        case 'float':
          part.mesh.position.y += Math.sin(t * 3 + (part.offset || 0)) * 0.003;
          break;
        case 'flame':
          const flameScale = 0.8 + Math.sin(t * 10 + (part.offset || 0) * 0.5) * 0.3;
          part.mesh.scale.y = flameScale;
          part.mesh.scale.x = 0.9 + Math.sin(t * 8 + (part.offset || 0)) * 0.2;
          break;
        case 'orbit':
          const orbitAngle = t * 1.5 + (part.offset || 0) * (Math.PI * 2 / 3);
          part.mesh.position.x = Math.cos(orbitAngle) * (part.radius || 0.25);
          part.mesh.position.z = Math.sin(orbitAngle) * (part.radius || 0.25);
          break;
        case 'blink':
          part.mesh.visible = Math.sin(t * 5) > 0;
          break;
        case 'punch':
          part.mesh.position.z = 0.1 + Math.abs(Math.sin(t * 3 + part.side)) * 0.15;
          break;
        case 'reach':
          part.mesh.position.x = 0.3 + Math.sin(t * 2) * 0.1;
          part.mesh.position.y = 0.6 + Math.cos(t * 2) * 0.05;
          break;
      }
    });
  });
  
  // Animate enemies
  enemies.forEach(e => {
    // Animate flames
    if (e.flames) {
      e.flames.forEach((flame, i) => {
        const flameScale = 0.7 + Math.sin(t * 12 + i * 0.8) * 0.4;
        flame.scale.y = flameScale;
        flame.scale.x = 0.85 + Math.sin(t * 10 + i) * 0.25;
      });
    }
    
    // Animate wings
    if (e.wings) {
      e.wings.forEach((wing, i) => {
        wing.rotation.z = Math.sin(t * 8) * 0.3 * (i === 0 ? 1 : -1);
      });
    }
    
    // Animate boss crown gem
    if (e.crownGem) {
      const gemScale = 1 + Math.sin(t * 4) * 0.2;
      e.crownGem.scale.setScalar(gemScale);
    }
  });
}

function updateCamera() {
  camera.position.x = Math.sin(camAngle) * camDist;
  camera.position.z = Math.cos(camAngle) * camDist;
  camera.position.y = camHeight;
  camera.lookAt(0, 0, 0);
}

function zoomIn() { camDist = Math.max(8, camDist - 2); camHeight = Math.max(5, camHeight - 1); updateCamera(); }
function zoomOut() { camDist = Math.min(40, camDist + 2); camHeight = Math.min(30, camHeight + 1); updateCamera(); }
function resetCam() { camAngle = Math.PI/4; camHeight = camDist * 0.6; updateCamera(); }

function onTouchStart(e) {
  e.preventDefault();
  if (e.touches.length === 1) {
    dragging = true; dragMoved = false;
    lastX = e.touches[0].clientX; lastY = e.touches[0].clientY;
    touchStart = Date.now();
  } else if (e.touches.length === 2) {
    const dx = e.touches[0].clientX - e.touches[1].clientX;
    const dy = e.touches[0].clientY - e.touches[1].clientY;
    touchStart = Math.sqrt(dx*dx + dy*dy);
  }
}

function onTouchMove(e) {
  e.preventDefault();
  if (e.touches.length === 1 && dragging) {
    const dx = e.touches[0].clientX - lastX;
    const dy = e.touches[0].clientY - lastY;
    if (Math.abs(dx) > 3 || Math.abs(dy) > 3) dragMoved = true;
    camAngle -= dx * 0.008;
    camHeight = Math.max(5, Math.min(30, camHeight - dy * 0.05));
    updateCamera();
    lastX = e.touches[0].clientX; lastY = e.touches[0].clientY;
  } else if (e.touches.length === 2) {
    const dx = e.touches[0].clientX - e.touches[1].clientX;
    const dy = e.touches[0].clientY - e.touches[1].clientY;
    const dist = Math.sqrt(dx*dx + dy*dy);
    camDist = Math.max(8, Math.min(40, camDist - (dist - touchStart) * 0.04));
    updateCamera();
    touchStart = dist;
  }
}

function onTouchEnd(e) {
  if (!dragMoved && Date.now() - touchStart < 200) handleTap(e.changedTouches[0]);
  dragging = false;
}

function onMouseDown(e) { dragging = true; dragMoved = false; lastX = e.clientX; lastY = e.clientY; }
function onMouseMove(e) {
  if (!dragging) return;
  const dx = e.clientX - lastX, dy = e.clientY - lastY;
  if (Math.abs(dx) > 2 || Math.abs(dy) > 2) dragMoved = true;
  camAngle -= dx * 0.008;
  camHeight = Math.max(5, Math.min(30, camHeight - dy * 0.05));
  updateCamera();
  lastX = e.clientX; lastY = e.clientY;
}
function onMouseUp() { dragging = false; }
function onWheel(e) { e.preventDefault(); e.deltaY > 0 ? zoomOut() : zoomIn(); }
function onClick(e) { if (!dragMoved) handleTap(e); }

function handleTap(e) {
  const rect = renderer.domElement.getBoundingClientRect();
  mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
  mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
  
  raycaster.setFromCamera(mouse, camera);
  const hits = raycaster.intersectObjects(cells);
  if (hits.length > 0) {
    const { x, y } = hits[0].object.userData;
    handleCellTap(x, y);
  }
}

function handleCellTap(x, y) {
  const cell = grid[y][x];
  
  if (sellMode && cell.tower) {
    let val = Math.floor(themeData.towers.find(t => t.id === cell.tower.type).cost * 0.6);
    for (let i = 0; i < cell.tower.lv; i++) val += Math.floor(themeData.towers.find(t => t.id === cell.tower.type).up[i] * 0.6);
    money += val;
    if (cell.tower.mesh) scene.remove(cell.tower.mesh);
    towers.splice(towers.indexOf(cell.tower), 1);
    cell.tower = null;
    onNavChanged();
    hideUpgrade();
    updateHUD();
    return;
  }
  
  if (cell.tower) { showUpgrade(cell.tower); return; }
  hideUpgrade();
  
  if (selectedTower && cell.type === 'ground') {
    const td = themeData.towers.find(t => t.id === selectedTower);
    if (money >= td.cost) {
      const tower = { type: selectedTower, x, y, lv: 0, dmg: td.dmg[0], rng: td.rng[0], rate: td.rate[0], lastShot: 0, hp: 160 };
      if (td.splash) tower.splash = td.splash[0];
      if (td.slow) { tower.slow = td.slow; tower.slowDur = td.slowDur[0]; }
      if (td.chain) { tower.chain = td.chain[0]; tower.chainRng = td.chainRng; }
      if (td.burn) { tower.burn = td.burn[0]; tower.burnDur = td.burnDur; }
      if (td.crit) tower.crit = td.crit;
      
      tower.mesh = createTowerMesh(tower);
      towers.push(tower);
      cell.tower = tower;
      money -= td.cost;
      onNavChanged();
      updateHUD();
    }
  }
}

function renderTowers() {
  const bar = document.getElementById('towerBar');
  bar.innerHTML = '';
  themeData.towers.forEach(t => {
    const btn = document.createElement('div');
    btn.className = 'tower-btn' + (money < t.cost ? ' disabled' : '') + (selectedTower === t.id ? ' selected' : '');
    btn.style.setProperty('--c', t.clr);
    btn.innerHTML = `<div class="tower-btn-icon">${t.icon}</div><div class="tower-btn-name">${t.nm}</div><div class="tower-btn-cost">$${t.cost}</div>`;
    btn.onclick = () => {
      if (money >= t.cost) {
        selectedTower = selectedTower === t.id ? null : t.id;
        sellMode = false;
        document.getElementById('sellBtn').classList.remove('active');
        hideUpgrade();
        renderTowers();
      }
    };
    bar.appendChild(btn);
  });
}

function updateHUD() {
  document.getElementById('moneyVal').textContent = money;
  document.getElementById('waveNum').textContent = wave;
  document.getElementById('waveMax').textContent = mapData.waves;
  document.getElementById('livesVal').textContent = lives;
  document.getElementById('scoreVal').textContent = score;
  document.getElementById('startBtn').disabled = waveActive;
  renderTowers();
}

function toggleSell() {
  sellMode = !sellMode;
  selectedTower = null;
  document.getElementById('sellBtn').classList.toggle('active', sellMode);
  hideUpgrade();
  renderTowers();
}
function toggleAutoWave() {
  autoWave = !autoWave;
  const b = document.getElementById('autoBtn');
  if (b) {
    b.textContent = autoWave ? 'AUTO: ON' : 'AUTO: OFF';
    b.classList.toggle('on', autoWave);
  }
}


function showUpgrade(tower) {
  selectedPlaced = tower;
  const td = themeData.towers.find(t => t.id === tower.type);
  
  document.getElementById('upIcon').textContent = td.icon;
  document.getElementById('upName').textContent = td.nm;
  document.getElementById('upLevel').textContent = 'Level ' + (tower.lv + 1);
  document.getElementById('upDmg').textContent = td.dmg[tower.lv];
  document.getElementById('upRng').textContent = td.rng[tower.lv].toFixed(1);
  document.getElementById('upRate').textContent = td.rate[tower.lv].toFixed(2);
  
  let sellVal = Math.floor(td.cost * 0.6);
  for (let i = 0; i < tower.lv; i++) sellVal += Math.floor(td.up[i] * 0.6);
  document.getElementById('upSell').textContent = sellVal;
  
  if (tower.lv >= 3) {
    document.getElementById('upDmgNext').textContent = 'MAX';
    document.getElementById('upRngNext').textContent = 'MAX';
    document.getElementById('upRateNext').textContent = 'MAX';
    document.getElementById('upBtn').disabled = true;
    document.getElementById('upCost').textContent = '---';
  } else {
    document.getElementById('upDmgNext').textContent = '→' + td.dmg[tower.lv + 1];
    document.getElementById('upRngNext').textContent = '→' + td.rng[tower.lv + 1].toFixed(1);
    document.getElementById('upRateNext').textContent = '→' + td.rate[tower.lv + 1].toFixed(2);
    document.getElementById('upCost').textContent = td.up[tower.lv];
    document.getElementById('upBtn').disabled = money < td.up[tower.lv];
  }
  
  document.getElementById('upgradeSheet').classList.add('show');
}

function hideUpgrade() {
  document.getElementById('upgradeSheet').classList.remove('show');
  selectedPlaced = null;
}

function doUpgrade() {
  if (!selectedPlaced || selectedPlaced.lv >= 3) return;
  const td = themeData.towers.find(t => t.id === selectedPlaced.type);
  if (money < td.up[selectedPlaced.lv]) return;
  
  money -= td.up[selectedPlaced.lv];
  selectedPlaced.lv++;
  selectedPlaced.hp = (selectedPlaced.hp||160) + 60;
  selectedPlaced.dmg = td.dmg[selectedPlaced.lv];
  selectedPlaced.rng = td.rng[selectedPlaced.lv];
  selectedPlaced.rate = td.rate[selectedPlaced.lv];
  
  if (td.splash) selectedPlaced.splash = td.splash[selectedPlaced.lv];
  if (td.slowDur) selectedPlaced.slowDur = td.slowDur[selectedPlaced.lv];
  if (td.chain) selectedPlaced.chain = td.chain[selectedPlaced.lv];
  if (td.burn) selectedPlaced.burn = td.burn[selectedPlaced.lv];
  
  if (selectedPlaced.rangeMesh) selectedPlaced.rangeMesh.geometry = new THREE.RingGeometry(selectedPlaced.rng - 0.05, selectedPlaced.rng, 64);
  
  // Rebuild mesh
  if (selectedPlaced.mesh) scene.remove(selectedPlaced.mesh);
  selectedPlaced.mesh = createTowerMesh(selectedPlaced);
  
  updateHUD();
  showUpgrade(selectedPlaced);
}

function sellTower() {
  if (!selectedPlaced) return;
  const td = themeData.towers.find(t => t.id === selectedPlaced.type);
  let val = Math.floor(td.cost * 0.6);
  for (let i = 0; i < selectedPlaced.lv; i++) val += Math.floor(td.up[i] * 0.6);
  money += val;
  
  const cell = grid[selectedPlaced.y][selectedPlaced.x];
  if (selectedPlaced.mesh) scene.remove(selectedPlaced.mesh);
  towers.splice(towers.indexOf(selectedPlaced), 1);
  cell.tower = null;
  onNavChanged();
  hideUpgrade();
  updateHUD();
}

function startWave() {
  if (waveActive || wave >= mapData.waves) return;
  waveActive = true;
  wave++;
  updateHUD();

  const waveData = WAVES[wave - 1] || {};
  // Track spawns so the wave doesn't "finish" before delayed spawns fire
  spawnsPending = 0;

  let delay = 0;
  Object.entries(waveData).forEach(([id, count]) => {
    const ed = themeData.enemies.find(e => e.id === id);
    if (!ed) return;
    spawnsPending += count;
    for (let i = 0; i < count; i++) {
      setTimeout(() => spawnEnemy(ed), delay);
      delay += 450;
    }
  });

  // Safety: if a wave had no valid enemies, allow completion
  if (spawnsPending === 0) {
    // let gameLoop settle this on next frame
  }
}


/* ==== UI helpers: readable projectiles + enemy power labels ==== */
function makeTextSprite(text, opts={}) {
  const color = opts.color || '#ffffff';
  const bg = opts.bg || 'rgba(0,0,0,0.55)';
  const font = opts.font || 'bold 54px system-ui, -apple-system, Segoe UI, Roboto, Arial';
  const pad = 18;

  const canvas = document.createElement('canvas');
  canvas.width = 256; canvas.height = 128;
  const ctx = canvas.getContext('2d');

  // Rounded rect background
  const r = 22, w = canvas.width, h = canvas.height;
  ctx.fillStyle = bg;
  ctx.beginPath();
  ctx.moveTo(r, 0);
  ctx.arcTo(w, 0, w, h, r);
  ctx.arcTo(w, h, 0, h, r);
  ctx.arcTo(0, h, 0, 0, r);
  ctx.arcTo(0, 0, w, 0, r);
  ctx.closePath();
  ctx.fill();

  // Text
  ctx.font = font;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillStyle = color;
  ctx.shadowColor = 'rgba(0,0,0,0.7)';
  ctx.shadowBlur = 8;
  ctx.fillText(text, w/2, h/2 + 2);

  const tex = new THREE.CanvasTexture(canvas);
  tex.anisotropy = 4;
  tex.minFilter = THREE.LinearFilter;
  tex.magFilter = THREE.LinearFilter;

  const mat = new THREE.SpriteMaterial({
    map: tex,
    transparent: true,
    depthTest: false,
    depthWrite: false
  });

  const spr = new THREE.Sprite(mat);
  spr.scale.set(0.85, 0.42, 1); // world units
  spr.renderOrder = 999;
  return spr;
}

function attachEnemyPowerLabel(e) {
  if (!e || !e.mesh) return;
  // Define "power" as a compact strength indicator; stable across difficulties.
  const power = Math.max(1, Math.round((e.maxHp / 20) + (wave * 0.6) + (e.armor ? 2 : 0) + (e.boss ? 6 : 0)));
  e.power = power;

  const label = makeTextSprite(String(power), { color: '#ffffff', bg: 'rgba(0,0,0,0.55)' });
  label.position.set(0, (e.flying ? 1.05 : 0.65) * (e.sz || 1), 0);
  e.mesh.add(label);
  e.label = label;
}
/* ==== end helpers ==== */

function spawnEnemy(ed) {
  const hw = COLS/2, hh = ROWS/2;
  const s = SPAWNS[Math.floor(Math.random() * SPAWNS.length)] || {x:0,y:Math.floor(ROWS/2)};
  const e = {
    type: ed.id,
    spawn: {x:s.x, y:s.y},
    x: s.x - hw + 0.5,
    y: 0.2,
    z: s.y - hh + 0.5,
    hp: ed.hp * (1 + wave * 0.12),
    maxHp: ed.hp * (1 + wave * 0.12),
    spd: ed.spd,
    rwd: ed.rwd,
    sz: ed.sz || 1,
    armor: ed.armor || 0,
    fire: ed.fire || false,
    flying: ed.flying || false,
    boss: ed.boss || false,
    pathIdx: 0,
    slow: 0,
    burnT: 0,
    burnD: 0,
    path: null,
    pathIdx: 1,
    navV: -1
  };

  e.mesh = createEnemyMesh(e);
  if (e.mesh) {
    e.mesh.position.set(e.x, e.flying ? 1.2 : 0.2, e.z);
    scene.add(e.mesh);
    attachEnemyPowerLabel(e);
  }
  enemies.push(e);

  if (spawnsPending > 0) spawnsPending--;
}

function gameLoop(t) {
  if (!running) return;
  
  const dt = Math.min((t - lastTime) / 1000, 0.1) * gameSpeed;
  lastTime = t;
  animTime += dt;
  
  updateEnemies(dt);
  updateTowers(t);
  updateProjectiles(dt);
  updateParticles(dt);
  updateAnimations(dt);
  
  renderer.render(scene, camera);
  
  if (waveActive && spawnsPending === 0 && enemies.length === 0 && projectiles.length === 0) {
    waveActive = false;
    updateHUD();

    if (autoWave && wave < mapData.waves) {
      if (autoWaveTimer) clearTimeout(autoWaveTimer);
      autoWaveTimer = setTimeout(() => {
        if (running && !waveActive && autoWave) startWave();
      }, 650);
    }
    
    if (wave >= mapData.waves) {
      document.getElementById('winScore').textContent = score;
      document.getElementById('winWaves').textContent = wave;
      document.getElementById('winModal').classList.add('show');
      running = false;
      return;
    }
  }
  
  requestAnimationFrame(gameLoop);
}


function updateEnemies(dt) {
  const hw = COLS/2, hh = ROWS/2;

  for (let i = enemies.length - 1; i >= 0; i--) {
    const e = enemies[i];

    if (e.slow > 0) e.slow -= dt;
    if (e.burnT > 0) { e.burnT -= dt; e.hp -= e.burnD * dt; }

    // Flying enemies: head straight for BASE (ignore obstacles/towers)
    if (e.flying) {
      const tx = BASE.x - hw + 0.5;
      const tz = BASE.y - hh + 0.5;
      const dx = tx - e.x, dz = tz - e.z;
      const dist = Math.sqrt(dx*dx + dz*dz) || 1;
      const spd = e.spd * dt;
      e.x += (dx/dist) * spd;
      e.z += (dz/dist) * spd;
      e.y = 1.2;
      if (e.mesh) {
        e.mesh.position.set(e.x, e.y, e.z);
        e.mesh.rotation.y = Math.atan2(dx, dz);
      }
      if (dist < 0.35) {
        lives--;
        removeEnemy(e, i);
        updateHUD();
      }
      continue;
    }

    // Ground enemies: shortest-path A* around obstacles + towers (towers are breakable with high cost).
    const gx = Math.max(0, Math.min(COLS-1, Math.floor(e.x + hw)));
    const gy = Math.max(0, Math.min(ROWS-1, Math.floor(e.z + hh)));

    if (e.navV !== navVersion || !e.path) {
      e.path = findPathGrid(gx, gy, BASE.x, BASE.y, true);
      e.pathIdx = 1;
      e.navV = navVersion;
    }

    // If path somehow missing, just idle (should be rare because towers are "breakable" in path cost)
    if (!e.path || e.path.length < 2) {
      // If already on base cell, count as leak
      if (gx === BASE.x && gy === BASE.y) {
        lives--;
        removeEnemy(e, i);
        updateHUD();
      }
      continue;
    }

    // Current target cell along planned route
    const step = e.path[Math.min(e.pathIdx, e.path.length - 1)];
    const sx = step[0], sy = step[1];

    const tx = sx - hw + 0.5;
    const tz = sy - hh + 0.5;

    let dx = tx - e.x, dz = tz - e.z;
    let dist = Math.sqrt(dx*dx + dz*dz);

    // If next cell contains a tower, "break" it when close enough
    const stepCell = grid[sy][sx];
    if (stepCell && stepCell.tower) {
      // move toward it but stop very close and attack
      const spd = e.spd * (e.slow > 0 ? 0.5 : 1) * dt;
      if (dist > 0.55) {
        const inv = 1 / (dist || 1);
        e.x += dx * inv * spd;
        e.z += dz * inv * spd;
      } else {
        // attack
        const t = stepCell.tower;
        t.hp = (t.hp ?? 160) - (35 * dt); // enemy "siege" DPS vs towers
        if (t.hp <= 0) {
          // remove tower
          if (t.mesh) scene.remove(t.mesh);
          towers.splice(towers.indexOf(t), 1);
          stepCell.tower = null;
          onNavChanged();
        }
      }
      e.y = 0.2;
      if (e.mesh) {
        e.mesh.position.set(e.x, e.y, e.z);
        if (dist > 1e-4) e.mesh.rotation.y = Math.atan2(dx, dz);
      }
      continue;
    }

    // Normal movement across multiple steps
    let remaining = e.spd * (e.slow > 0 ? 0.5 : 1) * dt;
    while (remaining > 0 && e.pathIdx < e.path.length) {
      const cell = e.path[e.pathIdx];
      const cx = cell[0] - hw + 0.5;
      const cz = cell[1] - hh + 0.5;
      dx = cx - e.x; dz = cz - e.z;
      dist = Math.sqrt(dx*dx + dz*dz);
      if (dist < 1e-6) { e.pathIdx++; continue; }
      if (dist <= remaining) {
        e.x += dx; e.z += dz;
        remaining -= dist;
        e.pathIdx++;
      } else {
        e.x += (dx/dist) * remaining;
        e.z += (dz/dist) * remaining;
        remaining = 0;
      }

      // If we reached the base cell, leak
      const cgx = Math.max(0, Math.min(COLS-1, Math.floor(e.x + hw)));
      const cgy = Math.max(0, Math.min(ROWS-1, Math.floor(e.z + hh)));
      if (cgx === BASE.x && cgy === BASE.y) {
        lives--;
        removeEnemy(e, i);
        updateHUD();
        break;
      }
    }

    e.y = 0.2;
    if (e.mesh) {
      e.mesh.position.set(e.x, e.y, e.z);
      if (Math.abs(dx)+Math.abs(dz) > 1e-4) e.mesh.rotation.y = Math.atan2(dx, dz);
    }
  }
}
function removeEnemy(e, i) {
  if (e.mesh) scene.remove(e.mesh);
  enemies.splice(i, 1);
}

function updateTowers(t) {
  const hw = COLS/2, hh = ROWS/2;
  
  towers.forEach(tw => {
    if (t - tw.lastShot < 1000 / tw.rate / gameSpeed) return;
    
    const tx = tw.x - hw + 0.5;
    const tz = tw.y - hh + 0.5;
    
    let target = null, bestScore = -Infinity;
    enemies.forEach(e => {
      const dx = e.x - tx, dz = e.z - tz;
      const dist = Math.sqrt(dx*dx + dz*dz);
      if (dist < tw.rng) {
        const score = e.pathIdx * 100 - dist + (e.boss ? 500 : 0);
        if (score > bestScore) { bestScore = score; target = e; }
      }
    });
    
    if (target) {
      // Spawn and track projectile
      const p = createProjectile(tw, target, tx, tz);
      if (p) projectiles.push(p);
      tw.lastShot = t;
      
      if (tw.mesh) {
        const angle = Math.atan2(target.x - tx, target.z - tz);
        tw.mesh.rotation.y = angle;
      }
    }
  });
}

function createProjectile(tw, target, sx, sz) {
  const td = themeData.towers.find(t => t.id === tw.type);
  const lv = tw.lv || 0;
  const idx = themeData.towers.indexOf(td);
  const isBakery = theme === 'bakery';

  // Base projectile parameters (keep existing ballistic / arcs logic)
  let geo, mat, speed = 8.5;
  const c = new THREE.Color(td.clr);

  // Theme-specific shapes
  if (isBakery) {
    switch(idx) {
      case 0: // Mixer whisk fling (silver bead)
        geo = new THREE.SphereGeometry(0.06, 10, 10);
        mat = new THREE.MeshStandardMaterial({ color: 0xcfd3df, metalness: 0.9, roughness: 0.2, emissive: 0x111111, emissiveIntensity: 0.2 });
        break;
      case 1: // Spoon smack (cookie crumb)
        geo = new THREE.IcosahedronGeometry(0.08, 0);
        mat = new THREE.MeshStandardMaterial({ color: 0xd7a56a, roughness: 0.9, metalness: 0.0 });
        speed = 7.5;
        break;
      case 2: // Rolling pin (shockwave handled elsewhere; use puff)
        geo = new THREE.SphereGeometry(0.07, 10, 10);
        mat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.7, metalness: 0.0, transparent:true, opacity:0.85 });
        break;
      case 3: // Oven mitts (freeze puff)
        geo = new THREE.SphereGeometry(0.07, 10, 10);
        mat = new THREE.MeshBasicMaterial({ color: 0x7fe9ff, transparent:true, opacity:0.8 });
        break;
      case 4: // Piping bag (frosting blob)
        geo = new THREE.SphereGeometry(0.09, 12, 12);
        mat = new THREE.MeshStandardMaterial({ color: 0xff7ac0, roughness: 0.25, metalness: 0.05, emissive: 0x7a1b40, emissiveIntensity: 0.2 });
        speed = 8.0;
        break;
      case 5: // Sprinkle gatling (sprinkle)
        geo = new THREE.CylinderGeometry(0.02, 0.02, 0.12, 8);
        mat = new THREE.MeshStandardMaterial({ color: c, roughness: 0.35, metalness: 0.05, emissive: c, emissiveIntensity: 0.15 });
        break;
      case 6: // Caramel torch (ember)
        geo = new THREE.SphereGeometry(0.06, 10, 10);
        mat = new THREE.MeshBasicMaterial({ color: 0xffc14d });
        speed = 9.5;
        break;
      case 7: // Trophy (gold bolt)
        geo = new THREE.OctahedronGeometry(0.07, 0);
        mat = new THREE.MeshStandardMaterial({ color: 0xfbbf24, metalness: 0.9, roughness: 0.2, emissive: 0x2a1a00, emissiveIntensity: 0.25 });
        speed = 9.0;
        break;
      default:
        geo = new THREE.SphereGeometry(0.06, 10, 10);
        mat = new THREE.MeshStandardMaterial({ color: c, emissive: c, emissiveIntensity: 0.2, roughness: 0.4, metalness: 0.1 });
    }
  } else {
    switch(idx) {
      case 0: // Drill shard
        geo = new THREE.ConeGeometry(0.05, 0.14, 10);
        mat = new THREE.MeshStandardMaterial({ color: 0xcfd3df, metalness: 0.95, roughness: 0.15, emissive: 0x111111, emissiveIntensity: 0.2 });
        speed = 9.0;
        break;
      case 1: // X-ray ray
        geo = new THREE.CylinderGeometry(0.03, 0.03, 0.22, 10);
        mat = new THREE.MeshBasicMaterial({ color: 0x7fe9ff });
        speed = 10.0;
        break;
      case 2: // Scaler shock pellet
        geo = new THREE.SphereGeometry(0.07, 10, 10);
        mat = new THREE.MeshBasicMaterial({ color: 0x22c7c5, transparent:true, opacity:0.85 });
        speed = 8.0;
        break;
      case 3: // Freeze spray droplet
        geo = new THREE.SphereGeometry(0.07, 10, 10);
        mat = new THREE.MeshBasicMaterial({ color: 0x7fe9ff, transparent:true, opacity:0.75 });
        speed = 8.5;
        break;
      case 4: // Suction glob
        geo = new THREE.SphereGeometry(0.09, 12, 12);
        mat = new THREE.MeshStandardMaterial({ color: 0x7fe9ff, roughness: 0.25, metalness: 0.05, emissive: 0x0a3a40, emissiveIntensity: 0.18, transparent:true, opacity:0.85 });
        break;
      case 5: // Floss arc (spark)
        geo = new THREE.BoxGeometry(0.08, 0.02, 0.02);
        mat = new THREE.MeshBasicMaterial({ color: 0xffffff });
        speed = 9.5;
        break;
      case 6: // Fluoride ember
        geo = new THREE.SphereGeometry(0.06, 10, 10);
        mat = new THREE.MeshBasicMaterial({ color: 0xff7a7a });
        speed = 9.0;
        break;
      case 7: // Crown laser bolt
        geo = new THREE.OctahedronGeometry(0.07, 0);
        mat = new THREE.MeshBasicMaterial({ color: 0xfbbf24 });
        speed = 10.0;
        break;
      default:
        geo = new THREE.SphereGeometry(0.06, 10, 10);
        mat = new THREE.MeshBasicMaterial({ color: c });
    }
  }

  const mesh = new THREE.Mesh(geo, mat);
  mesh.castShadow = true;

  // Make projectiles easier to see (definition + glow)
  mesh.scale.multiplyScalar(1.35);
  const glowCol = (mat && mat.color) ? mat.color : new THREE.Color(c);
  const glowGeo = new THREE.SphereGeometry(0.12, 10, 10);
  const glowMat = new THREE.MeshBasicMaterial({
    color: glowCol,
    transparent: true,
    opacity: 0.35,
    blending: THREE.AdditiveBlending,
    depthWrite: false
  });
  const glow = new THREE.Mesh(glowGeo, glowMat);
  glow.renderOrder = 998;
  mesh.add(glow);

  mesh.position.set(sx, 0.45, sz);
  scene.add(mesh);

  return {
    mesh,
    tower: tw,
    target,
    tx: target.x,
    ty: (target.y != null ? target.y : (target.flying ? 1.2 : 0.2)),
    tz: target.z,
    x: sx, z: sz,
    y: 0.45,
    vx: 0, vz: 0,
    vy: 0,
    t: 0,
    speed
  };
}

function updateProjectiles(dt) {
  for (let i = projectiles.length - 1; i >= 0; i--) {
    const p = projectiles[i];
    if (enemies.includes(p.target)) { p.tx = p.target.x; p.ty = p.target.y; p.tz = p.target.z; }
    
    const dx = p.tx - p.x, dy = p.ty - p.y, dz = p.tz - p.z;
    const dist = Math.sqrt(dx*dx + dy*dy + dz*dz);
    const move = p.speed * dt;
    
    if (dist <= move) {
      handleHit(p);
      if (p.mesh) scene.remove(p.mesh);
      projectiles.splice(i, 1);
    } else {
      p.x += (dx/dist)*move;
      p.y += (dy/dist)*move;
      p.z += (dz/dist)*move;
      if (p.mesh) {
        p.mesh.position.set(p.x, p.y, p.z);
        p.mesh.rotation.y += dt * 10; // Spin
      }
    }
  }
}

function handleHit(p) {
  const tw = p.tower;
  let dmg = tw.dmg;
  
  if (tw.crit && Math.random() < tw.crit) { dmg *= 3; createExplosion(p.x, p.y, p.z, false, 0xffd700); }
  
  if (tw.splash) {
    enemies.forEach(e => {
      const dx = e.x - p.x, dz = e.z - p.z;
      const dist = Math.sqrt(dx*dx + dz*dz);
      if (dist < tw.splash) hurtEnemy(e, dmg * (1 - dist/tw.splash/2));
    });
    createExplosion(p.x, p.y, p.z, false);
  } else if (tw.chain && p.target && enemies.includes(p.target)) {
    let current = p.target;
    hurtEnemy(current, dmg);
    for (let c = 0; c < tw.chain; c++) {
      let next = null, minDist = tw.chainRng;
      enemies.forEach(e => {
        if (e === current) return;
        const dx = e.x - current.x, dz = e.z - current.z;
        const dist = Math.sqrt(dx*dx + dz*dz);
        if (dist < minDist) { minDist = dist; next = e; }
      });
      if (next) { createLightning(current.x, current.z, next.x, next.z); hurtEnemy(next, dmg * 0.5); current = next; }
    }
  } else if (p.target && enemies.includes(p.target)) {
    hurtEnemy(p.target, dmg);
    if (tw.slow) p.target.slow = tw.slowDur;
    if (tw.burn) { p.target.burnT = tw.burnDur; p.target.burnD = tw.burn; }
  }
}

function hurtEnemy(e, dmg) { e.hp -= dmg * (1 - e.armor); }

function createExplosion(x, y, z, isFire, color) {
  const c = color || (isFire ? 0xff4400 : 0xff8800);
  for (let i = 0; i < 8; i++) {
    const p = { x, y, z, vx: (Math.random()-0.5)*4, vy: Math.random()*4+2, vz: (Math.random()-0.5)*4, life: 0.5 };
    const mesh = new THREE.Mesh(new THREE.SphereGeometry(0.06, 6, 6), new THREE.MeshBasicMaterial({ color: c }));
    mesh.position.set(x, y, z);
    scene.add(mesh);
    p.mesh = mesh;
    particles.push(p);
  }
}

function createLightning(x1, z1, x2, z2) {
  const dx = x2-x1, dz = z2-z1;
  const len = Math.sqrt(dx*dx + dz*dz);
  const geo = new THREE.CylinderGeometry(0.04, 0.04, len, 6);
  geo.rotateX(Math.PI/2);
  const mesh = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({ color: 0xa855f7 }));
  mesh.position.set((x1+x2)/2, 0.5, (z1+z2)/2);
  mesh.lookAt(x2, 0.5, z2);
  scene.add(mesh);
  setTimeout(() => scene.remove(mesh), 100);
}

function updateParticles(dt) {
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.z += p.vz * dt;
    p.vy -= 15 * dt;
    p.life -= dt;
    if (p.mesh) { p.mesh.position.set(p.x, p.y, p.z); p.mesh.scale.setScalar(p.life * 2); }
    if (p.life <= 0 || p.y < 0) { if (p.mesh) scene.remove(p.mesh); particles.splice(i, 1); }
  }
}

function onResize() {
  const wrap = document.querySelector('.canvas-wrap');
  if (!wrap || !camera || !renderer) return;
  camera.aspect = wrap.clientWidth / wrap.clientHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(wrap.clientWidth, wrap.clientHeight);
}

function closeModal(type) {
  document.getElementById(type + 'Modal').classList.remove('show');
  selectTheme(theme);
}

document.querySelectorAll('.speed-btn').forEach(btn => {
  btn.onclick = () => {
    gameSpeed = +btn.dataset.speed;
    document.querySelectorAll('.speed-btn').forEach(b => b.classList.toggle('active', +b.dataset.speed === gameSpeed));
  };
});
</script>
</body>
</html>
