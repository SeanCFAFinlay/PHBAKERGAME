{
  "name": "phbakergame",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Tower Defense Game + Editor Dashboard",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:game": "npm run dev --workspace=apps/game",
    "dev:editor": "npm run dev --workspace=apps/editor",
    "build": "npm run build --workspaces --if-present",
    "build:game": "npm run build --workspace=apps/game",
    "build:editor": "npm run build --workspace=apps/editor",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "optimize:gltf": "echo 'glTF optimization placeholder - add gltf-transform when needed'",
    "compress:textures": "echo 'Texture compression placeholder - add sharp when needed'",
    "validate:assets": "echo 'Asset validation placeholder'"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/three": "^0.160.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-static-copy": "^3.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
